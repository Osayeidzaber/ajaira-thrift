{%- comment -%}
  "You may also like" (veyroze vz-rel). Loads Shopify product recommendations
  through the Section Rendering API, optionally keeping only pieces in the same size.
{%- endcomment -%}
{%- liquid
  assign size_names = section.settings.size_option_names | downcase | split: ','
  assign current_sizes = ''
  if product
    for option in product.options_with_values
      assign oname = option.name | downcase | strip
      if size_names contains oname
        for value in option.values
          if value.available
            assign current_sizes = current_sizes | append: '|' | append: value
          endif
        endfor
      endif
    endfor
  endif
-%}
<aj-related
  class="vz-rel color-{{ section.settings.color_scheme }}"
  style="--rel-cols: {{ section.settings.columns }}; --rel-pt: {{ section.settings.padding_top }}px; --rel-pb: {{ section.settings.padding_bottom }}px;"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.fetch_limit }}&intent=related"
  data-same-size="{{ section.settings.same_size }}"
  data-fallback="{{ section.settings.fallback_any }}"
  data-sizes="{{ current_sizes | downcase | escape }}|"
  data-max="{{ section.settings.limit }}"
>
  <h2 class="vz-rel__head">{{ section.settings.heading | escape }}</h2>
  <div class="vz-rel__grid" data-rel-grid>
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      {%- for p in recommendations.products -%}
        {%- liquid
          assign sizes = ''
          for option in p.options_with_values
            assign oname = option.name | downcase | strip
            if size_names contains oname
              for value in option.values
                if value.available
                  assign sizes = sizes | append: '|' | append: value
                endif
              endfor
            endif
          endfor
        -%}
        {%- render 'vz-rel-card', p: p, sizes: sizes, badge: section.settings.badge -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
  {%- liquid
    assign backup = section.settings.fallback_collection
    if backup == blank
      assign backup = product.collections.first
    endif
    if backup == blank
      assign backup = collections.all
    endif
  -%}
  <template data-rel-backup>
    {%- assign shown = 0 -%}
    {%- for p in backup.products limit: 24 -%}
      {%- if p.id != product.id and p.available and shown < 12 -%}
        {%- assign shown = shown | plus: 1 -%}
        {%- render 'vz-rel-card', p: p, sizes: '', badge: section.settings.badge -%}
      {%- endif -%}
    {%- endfor -%}
  </template>
  <p class="vz-rel__empty" data-rel-empty hidden>{{ section.settings.empty_text | escape }}</p>
</aj-related>

{% stylesheet %}
  .vz-rel { --gold: #c8a45c; --muted: rgba(255, 255, 255, 0.5); display: block; max-width: 1380px; margin: 0 auto; padding: var(--rel-pt, 30px) 40px var(--rel-pb, 80px); }
  .vz-rel__head { font-family: var(--font-heading-family, inherit); font-size: clamp(1.8rem, 2.6vw, 2.4rem); font-weight: 400; margin: 0 0 26px; letter-spacing: 0.005em; }
  .vz-rel__grid { display: grid; grid-template-columns: repeat(var(--rel-cols, 4), 1fr); gap: 22px; }
  .vz-rel__grid:empty { display: none; }
  @media (max-width: 960px) { .vz-rel { padding: 20px 20px 60px; } .vz-rel__grid { grid-template-columns: repeat(2, 1fr); gap: 14px; } }
  .vz-rel__card { display: flex; flex-direction: column; }
  .vz-rel__link { text-decoration: none; color: inherit; display: block; flex: 1; }
  .vz-rel__card[hidden] { display: none; }
  .vz-rel__imgwrap { position: relative; aspect-ratio: 1; overflow: hidden; border-radius: 8px; background: #0f0f11; margin-bottom: 12px; }
  .vz-rel__img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.45s ease; }
  .vz-rel__link:hover .vz-rel__img { transform: scale(1.05); }
  .vz-rel__badge { position: absolute; top: 10px; left: 10px; font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); background: rgba(11, 11, 12, 0.7); backdrop-filter: blur(6px); border: 1px solid rgba(200, 164, 92, 0.3); border-radius: 30px; padding: 5px 11px; }
  .vz-rel__title { font-size: 1.02rem; line-height: 1.3; margin: 0 0 5px; text-wrap: balance; overflow-wrap: break-word; }
  .vz-rel__price { font-family: var(--font-heading-family, inherit); font-size: 1.15rem; color: var(--muted); }
  .vz-rel__empty { color: var(--muted); font-size: 1rem; }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('aj-related')) {
    customElements.define('aj-related', class extends HTMLElement {
      connectedCallback() {
        if (this.dataset.loaded) return;
        this.dataset.loaded = '1';
        const io = new IntersectionObserver((entries, obs) => {
          if (!entries[0].isIntersecting) return;
          obs.disconnect();
          this.load();
        }, { rootMargin: '0px 0px 400px 0px' });
        io.observe(this);
      }
      async load() {
        const grid = this.querySelector('[data-rel-grid]');
        try {
          const res = await fetch(this.dataset.url);
          const html = await res.text();
          const doc = new DOMParser().parseFromString(html, 'text/html');
          const fresh = doc.querySelector('[data-rel-grid]');
          if (fresh) grid.innerHTML = fresh.innerHTML;
        } catch (e) { /* keep server markup */ }
        // No Shopify recommendations yet (new store / few sales): use the backup collection
        if (!grid.querySelector('.vz-rel__card')) {
          const backup = this.querySelector('template[data-rel-backup]');
          if (backup) grid.innerHTML = backup.innerHTML;
        }
        this.filter();
      }
      filter() {
        const cards = [...this.querySelectorAll('.vz-rel__card')];
        const max = Number(this.dataset.max || 4);
        const mine = (this.dataset.sizes || '|').split('|').filter(Boolean);
        let pool = cards;
        if (this.dataset.sameSize === 'true' && mine.length) {
          const matching = cards.filter((c) => (c.dataset.sizes || '').split('|').some((s) => s && mine.includes(s)));
          pool = matching.length || this.dataset.fallback !== 'true' ? matching : cards;
        }
        cards.forEach((c) => { c.hidden = true; });
        pool.slice(0, max).forEach((c) => { c.hidden = false; });
        this.querySelector('[data-rel-empty]').hidden = pool.length > 0;
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "You may also like",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "checkbox",
      "id": "same_size",
      "label": "Only show pieces in the same size",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "fallback_any",
      "label": "If none match the size, show other recommendations",
      "default": true
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Backup collection",
      "info": "Shown when Shopify has no recommendations yet. Empty uses the product's own collection."
    },
    {
      "type": "text",
      "id": "size_option_names",
      "label": "Size option names",
      "default": "size,größe,waist,taille",
      "info": "Comma-separated variant option names that count as size."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Text when nothing matches",
      "default": "No other pieces in this size right now."
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge on cards",
      "default": "1 of 1"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products shown",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "fetch_limit",
      "label": "Recommendations to check",
      "min": 4,
      "max": 10,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
