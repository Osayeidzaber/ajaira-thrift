{% javascript %}
  (() => {
    const init = (root) => {
      if (root.dataset.vzReady) return;
      root.dataset.vzReady = '1';
      const img = root.querySelector('[data-vz-main] img');
      const thumbs = [...root.querySelectorAll('[data-vz-thumb]')];
      if (!img || thumbs.length < 2) return;
      const show = (i) => {
        const t = thumbs[(i + thumbs.length) % thumbs.length];
        img.classList.add('is-swapping');
        const pre = new Image();
        pre.onload = pre.onerror = () => {
          img.srcset = t.dataset.srcset;
          img.src = t.dataset.src;
          img.classList.remove('is-swapping');
        };
        pre.src = t.dataset.src;
        thumbs.forEach((x) => x.classList.toggle('on', x === t));
      };
      const current = () => Math.max(0, thumbs.findIndex((t) => t.classList.contains('on')));
      thumbs.forEach((t, i) => t.addEventListener('click', () => show(i)));
      root.querySelectorAll('[data-vz-arrow]').forEach((b) => b.addEventListener('click', () => show(current() + Number(b.dataset.vzArrow))));
      const main = root.querySelector('[data-vz-main]');
      let x0 = null;
      main.addEventListener('pointerdown', (e) => { x0 = e.clientX; }, { passive: true });
      main.addEventListener('pointerup', (e) => {
        if (x0 === null) return;
        const dx = e.clientX - x0;
        x0 = null;
        if (Math.abs(dx) > 40) show(current() + (dx < 0 ? 1 : -1));
      });
      main.tabIndex = 0;
      main.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') show(current() + 1);
        if (e.key === 'ArrowLeft') show(current() - 1);
      });
    };
    const all = () => document.querySelectorAll('[data-vz]').forEach(init);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', all); else all();
    document.addEventListener('shopify:section:load', all);
  })();
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.vz-product-form .shopify-payment-button__button--unbranded');
    if (!btn || btn.disabled) return;
    btn.classList.add('is-loading');
    setTimeout(() => btn.classList.remove('is-loading'), 8000);
  });
  window.addEventListener('pageshow', () => {
    document.querySelectorAll('.shopify-payment-button__button.is-loading').forEach((b) => b.classList.remove('is-loading'));
  });
  document.addEventListener('click', (e) => {
    const open = e.target.closest('[data-sg-open]');
    if (open) {
      const dlg = document.getElementById(open.dataset.sgOpen);
      if (dlg && typeof dlg.showModal === 'function') { dlg.showModal(); document.documentElement.classList.add('vz-sg-lock'); }
      return;
    }
    const dlg = e.target.closest('dialog.vz-sg');
    if (dlg && (e.target.closest('[data-sg-close]') || e.target === dlg)) dlg.close();
  });
  document.addEventListener('close', (e) => {
    if (e.target.matches && e.target.matches('dialog.vz-sg')) document.documentElement.classList.remove('vz-sg-lock');
  }, true);
  // Esc closes the size guide (also covers browsers that skip the native cancel)
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll('dialog.vz-sg[open]').forEach((d) => d.close());
  });
  // Phone bottom sheet: drag the header down to close
  (() => {
    let dlg = null, y0 = 0, dy = 0, dragging = false;
    const start = (e) => {
      const head = e.target.closest('dialog.vz-sg .vz-sg__title');
      if (!head || window.innerWidth > 749) return;
      dlg = head.closest('dialog');
      const panel = dlg.querySelector('.vz-sg__panel');
      if (panel && panel.scrollTop > 0) return;
      dragging = true; y0 = e.touches[0].clientY; dy = 0;
      dlg.style.transition = 'none';
    };
    const move = (e) => {
      if (!dragging) return;
      dy = Math.max(0, e.touches[0].clientY - y0);
      dlg.style.transform = `translateY(${dy}px)`;
      if (e.cancelable) e.preventDefault();
    };
    const end = () => {
      if (!dragging) return;
      dragging = false;
      dlg.style.transition = 'transform 0.25s ease';
      if (dy > 90) {
        dlg.style.transform = 'translateY(100%)';
        setTimeout(() => { dlg.close(); dlg.style.transform = ''; dlg.style.transition = ''; }, 220);
      } else {
        dlg.style.transform = '';
      }
    };
    document.addEventListener('touchstart', start, { passive: true });
    document.addEventListener('touchmove', move, { passive: false });
    document.addEventListener('touchend', end);
    document.addEventListener('touchcancel', end);
  })();
{% endjavascript %}



{% schema %}
{
  "name": "Product page (veyroze)",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Product details"
    },
