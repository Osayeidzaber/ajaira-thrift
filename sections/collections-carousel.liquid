<section class="vc-section color-{{ section.settings.color_scheme }}" style="--vc-heading: {{ section.settings.heading_size }}px; --vc-align: {{ section.settings.text_align }}; --vc-label-size: {{ section.settings.label_size }}px;{% if section.settings.dot_color != blank %} --vc-dot: {{ section.settings.dot_color }};{% endif %}">
  <h2 class="vc-heading">{{ section.settings.heading }}</h2>

  {% capture slides_json %}[
    {%- if section.settings.collections.size > 0 -%}
      {%- for c in section.settings.collections -%}
        {%- if c.featured_image -%}
          { "url": {{ c.url | json }}, "title": {{ c.title | json }}, "src400": {{ c.featured_image | image_url: width: 400 | json }}, "src700": {{ c.featured_image | image_url: width: 700 | json }}, "src1000": {{ c.featured_image | image_url: width: 1000 | json }} }{% unless forloop.last %},{% endunless %}
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        {%- assign placeholder_name = 'collection-apparel-' | append: i -%}
        {%- capture placeholder_svg -%}{{ placeholder_name | placeholder_svg_tag: 'placeholder' }}{%- endcapture -%}
        {%- assign placeholder_src = placeholder_svg | url_encode | replace: '+', '%20' | prepend: 'data:image/svg+xml,' -%}
        { "url": {{ routes.all_products_collection_url | json }}, "title": {{ 'onboarding.collection_title' | t | replace: '&#39;', "'" | json }}, "src400": {{ placeholder_src | json }}, "src700": {{ placeholder_src | json }}, "src1000": {{ placeholder_src | json }} }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    {%- endif -%}
  ]{% endcapture %}

  <div data-island="carousel" data-island-id="{{ section.id }}">
    <div class="vc-fallback">
      {%- if section.settings.collections.size > 0 -%}
        {%- for c in section.settings.collections -%}
          <a class="vc-fallback__card" href="{{ c.url }}">
            {%- if c.featured_image -%}{{ c.featured_image | image_url: width: 600 | image_tag: loading: 'lazy' }}{%- endif -%}
            <span>{{ c.title }}</span>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          {%- assign placeholder_name = 'collection-apparel-' | append: i -%}
          <div class="vc-fallback__card">
            {{ placeholder_name | placeholder_svg_tag: 'placeholder' }}
            <span>{{ 'onboarding.collection_title' | t }}</span>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
  <script type="application/json" data-island-props="{{ section.id }}">{ "slides": {{ slides_json }} }</script>
</section>

{% stylesheet %}
  .vc-section { width: 100%; padding: 35px 0 40px; overflow: hidden; background: transparent; }
  .vc-heading {
    text-align: var(--vc-align, center);
    margin: 0 0 36px;
    font-size: var(--vc-heading, 34px);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
    line-height: 1.2;
  }
  @media (max-width: 768px) { .vc-heading { font-size: calc(var(--vc-heading, 34px) * 0.765); margin-bottom: 28px; } }
  @media (max-width: 480px) { .vc-heading { font-size: 22px; margin-bottom: 24px; } }
  .vc-fallback { display: grid; gap: 1rem; grid-template-columns: repeat(2, 1fr); max-width: var(--container); margin: 0 auto; padding: 0 1.5rem; }
  .vc-fallback__card { position: relative; border: 1px solid var(--color-line); overflow: hidden; background: var(--color-panel); }
  .vc-fallback__card img, .vc-fallback__card svg { width: 100%; height: auto; display: block; object-fit: cover; background: var(--color-panel); }
  .vc-fallback__card span { position: absolute; left: 0; right: 0; bottom: 0; text-align: center; padding: 0.6rem; font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; background: linear-gradient(transparent, rgba(0,0,0,0.6)); }
  @media (min-width: 750px) { .vc-fallback { grid-template-columns: repeat(4, 1fr); } }
{% endstylesheet %}

{% schema %}
{
  "name": "Collections carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 8
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Typography & layout"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Collection name size",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "info": "Leave empty to keep the veyroze default."
    }
  ],
  "presets": [
    {
      "name": "Collections carousel"
    }
  ]
}
{% endschema %}