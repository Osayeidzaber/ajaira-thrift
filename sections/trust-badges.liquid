<div class="trust-badges color-{{ section.settings.color_scheme }}">
  {% for block in section.blocks %}
    <div class="trust-badges__item" {{ block.shopify_attributes }}>
      <span class="trust-badges__icon" aria-hidden="true">{{ block.settings.icon }}</span>
      <span>{{ block.settings.text }}</span>
    </div>
  {% endfor %}
</div>

{% stylesheet %}
  .trust-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--color-line-soft);
    border-bottom: 1px solid var(--color-line-soft);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .trust-badges__item { display: flex; align-items: center; gap: 0.5rem; }
  .trust-badges__icon { color: var(--color-cta); }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust badges",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji/char)", "default": "✓" },
        { "type": "text", "id": "text", "label": "Text", "default": "Worldwide shipping" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "🌍", "text": "Worldwide shipping" } },
        { "type": "badge", "settings": { "icon": "↩", "text": "14 days return policy" } },
        { "type": "badge", "settings": { "icon": "🔒", "text": "Secure checkout" } }
      ]
    }
  ]
}
{% endschema %}