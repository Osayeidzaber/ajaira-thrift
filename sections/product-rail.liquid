{%- liquid
  if section.settings.source == 'manual'
    assign items = section.settings.products
  else
    assign items = section.settings.collection.products
  endif
  assign btn_url = section.settings.button_link
  if btn_url == blank and section.settings.collection != blank
    assign btn_url = section.settings.collection.url
  endif
-%}
<section
  class="aj-rail color-{{ section.settings.color_scheme }} gradient"
  style="--rail-item: {{ section.settings.item_width }}px; --rail-item-m: {{ section.settings.item_width_mobile }}px; --rail-pt: {{ section.settings.padding_top }}px; --rail-pb: {{ section.settings.padding_bottom }}px;{% if section.settings.rail_color != blank %} --rail-color: {{ section.settings.rail_color }};{% endif %}"
  data-aj-rail
>
  {%- if section.settings.heading != blank -%}
    <h2 class="aj-rail__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="aj-rail__wrap">
    <span class="aj-rail__bar" aria-hidden="true"></span>
    <ul class="aj-rail__track" role="list" data-rail-track>
      {%- if items.size > 0 -%}
        {%- for product in items limit: section.settings.limit -%}
          <li class="aj-rail__item">
            <a href="{{ product.url }}" class="aj-rail__link" aria-label="{{ product.title | escape }}">
              <span class="aj-rail__hook" aria-hidden="true"></span>
              {%- if product.featured_media -%}
                {{ product.featured_media | image_url: width: 500 | image_tag: loading: 'lazy', sizes: '200px', widths: '200, 300, 400, 500', alt: product.title }}
              {%- else -%}
                {{ 'product-apparel-2' | placeholder_svg_tag: 'aj-rail__placeholder' }}
              {%- endif -%}
              <span class="aj-rail__tip">
                {{- product.title | escape -}}
                {%- if section.settings.show_price %} · {{ product.price | money }}{% endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..8) -%}
          <li class="aj-rail__item"><span class="aj-rail__link"><span class="aj-rail__hook" aria-hidden="true"></span>{{ 'product-apparel-2' | placeholder_svg_tag: 'aj-rail__placeholder' }}</span></li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
  {%- if section.settings.button_label != blank and btn_url != blank -%}
    <div class="aj-rail__footer">
      <a class="aj-rail__btn" href="{{ btn_url }}">
        {{- section.settings.button_label | escape -}}
        <span class="aj-rail__btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      </a>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .aj-rail { padding: var(--rail-pt, 48px) 0 var(--rail-pb, 48px); overflow: hidden; }
  .aj-rail__heading { text-align: center; margin: 0 0 24px; font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; font-weight: 500; }
  .aj-rail__wrap { position: relative; }
  .aj-rail__bar { position: absolute; top: 14px; left: 0; right: 0; height: 4px; border-radius: 2px; background: var(--rail-color, rgba(var(--color-foreground), 0.35)); box-shadow: 0 1px 0 rgba(0, 0, 0, 0.25); }
  .aj-rail__track { list-style: none; margin: 0; padding: 0 5vw 24px; display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; cursor: grab; }
  .aj-rail__track::-webkit-scrollbar { display: none; }
  .aj-rail__track.is-dragging { cursor: grabbing; scroll-snap-type: none; }
  .aj-rail__item { flex: 0 0 var(--rail-item, 110px); scroll-snap-align: center; }
  .aj-rail__link { position: relative; display: block; padding-top: 30px; color: inherit; text-decoration: none; transform-origin: 50% 0; transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .aj-rail__link:hover { transform: rotate(-3deg); }
  .aj-rail__hook { position: absolute; top: 4px; left: 50%; width: 14px; height: 30px; transform: translateX(-50%); border: 2px solid var(--rail-color, rgba(var(--color-foreground), 0.45)); border-bottom: 0; border-radius: 8px 8px 0 0; }
  .aj-rail__link img, .aj-rail__placeholder { display: block; width: 100%; height: auto; max-height: calc(var(--rail-item, 110px) * 1.34); aspect-ratio: 3 / 4; object-fit: contain; filter: drop-shadow(0 8px 10px rgba(0, 0, 0, 0.25)); pointer-events: none; }
  .aj-rail__tip { position: absolute; left: 50%; bottom: -6px; transform: translate(-50%, 100%); white-space: nowrap; font-size: 11px; letter-spacing: 0.04em; opacity: 0; transition: opacity 0.2s; pointer-events: none; }
  .aj-rail__link:hover .aj-rail__tip, .aj-rail__link:focus-visible .aj-rail__tip { opacity: 0.8; }
  .aj-rail__footer { text-align: center; margin-top: 32px; }
  .aj-rail__btn { display: inline-flex; align-items: center; gap: 12px; padding: 8px 8px 8px 20px; border: 1px solid rgba(var(--color-foreground), 0.6); border-radius: 999px; color: inherit; text-decoration: none; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; transition: background 0.2s, color 0.2s; }
  .aj-rail__btn-icon { width: 26px; height: 26px; border-radius: 50%; background: rgb(var(--color-foreground)); color: rgb(var(--color-background)); display: flex; align-items: center; justify-content: center; }
  .aj-rail__btn-icon svg { width: 14px; height: 14px; }
  .aj-rail__btn:hover { background: rgba(var(--color-foreground), 0.08); }
  @media (max-width: 749px) { .aj-rail__item { flex-basis: var(--rail-item-m, 90px); } }
{% endstylesheet %}

{% javascript %}
  (() => {
    const init = (root) => {
      const track = root.querySelector('[data-rail-track]');
      if (!track || track.dataset.ready) return;
      track.dataset.ready = '1';
      let down = false, startX = 0, startLeft = 0, moved = false;
      track.addEventListener('pointerdown', (e) => {
        if (e.pointerType !== 'mouse') return;
        down = true; moved = false; startX = e.clientX; startLeft = track.scrollLeft;
      });
      window.addEventListener('pointermove', (e) => {
        if (!down) return;
        const dx = e.clientX - startX;
        if (Math.abs(dx) > 4) { moved = true; track.classList.add('is-dragging'); }
        track.scrollLeft = startLeft - dx;
      });
      window.addEventListener('pointerup', () => { down = false; track.classList.remove('is-dragging'); });
      track.addEventListener('click', (e) => { if (moved) { e.preventDefault(); moved = false; } }, true);
    };
    const all = () => document.querySelectorAll('[data-aj-rail]').forEach(init);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', all); else all();
    document.addEventListener('shopify:section:load', all);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Product rail",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Products hang from a clothes rail. Cut-out photos (transparent background) look best." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "On the rail" },
    { "type": "select", "id": "source", "label": "Show", "default": "collection", "options": [{ "value": "collection", "label": "Products from a collection" }, { "value": "manual", "label": "Products I pick" }] },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 30 },
    { "type": "range", "id": "limit", "label": "Maximum products", "min": 4, "max": 30, "step": 1, "default": 14 },
    { "type": "checkbox", "id": "show_price", "label": "Show price on hover", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See availability" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to the collection." },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "item_width", "label": "Item width on desktop", "min": 70, "max": 220, "step": 5, "unit": "px", "default": 110 },
    { "type": "range", "id": "item_width_mobile", "label": "Item width on mobile", "min": 60, "max": 180, "step": 5, "unit": "px", "default": 90 },
    { "type": "header", "content": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color", "id": "rail_color", "label": "Rail and hook color", "info": "Leave empty to follow the text color." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "Product rail" }]
}
{% endschema %}
