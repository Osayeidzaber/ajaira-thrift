            "table_columns": "cm,XS,S,M,L,XL",
            "table_rows": "Length,72,74,76,78,80\nChest,52,54,56,58,60",
            "table_note": "Tolerance ±1 cm. Measured flat."
          }
        },
        "acc-shipping": {
          "type": "accordion",
          "settings": {
            "heading": "Shipping & returns",
            "content": "<p>Shipped with care. 14-day returns on unworn pieces.</p>"
          }
        },
        "acc-care": {
          "type": "accordion",
          "settings": {
            "heading": "Care",
            "content": "<p>Follow the care label. When in doubt, hand wash cold and air dry.</p>"
          }
        }
      },
      "block_order": [
        "spec-fabric",
        "spec-fit",
        "spec-tag",
        "spec-condition",
        "acc-fabric",
        "acc-fit",
        "acc-shipping",
        "acc-care"
