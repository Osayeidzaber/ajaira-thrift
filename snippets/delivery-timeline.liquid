{% doc %}
  veyroze "Ordered → Shipped → Delivered" timeline. The server renders today's
  date as a fallback; assets/delivery-timeline.js recalculates the ranges from
  the shopper's local date (page caching would otherwise freeze the dates).

  @param {object} block - the product-hero `delivery` block

  @example
  {% render 'delivery-timeline', block: block %}
{% enddoc %}
<div
  class="vz-delivery"
  style="--vz-dot: {{ block.settings.dot_color }};{% if block.settings.line_color != blank %} --vz-line: {{ block.settings.line_color }};{% endif %}{% if block.settings.text_color != blank %} --vz-text: {{ block.settings.text_color }};{% endif %} --vz-date-size: {{ block.settings.date_size | default: 11 }}px; --vz-title-size: {{ block.settings.label_size | default: 12 }}px; --vz-dot-size: {{ block.settings.icon_size | default: 38 }}px;"
  data-vz-delivery
  data-business="{{ block.settings.business_days }}"
  data-ship="{{ block.settings.ship_min }},{{ block.settings.ship_max }}"
  data-deliver="{{ block.settings.deliver_min }},{{ block.settings.deliver_max }}"
  data-locale="{{ request.locale.iso_code }}"
  {{ block.shopify_attributes }}
>
  <div class="vz-delivery__top" aria-hidden="true">
    <span class="vz-delivery__dot">
      <svg viewBox="0 0 24 24"><path d="M7 7V6a5 5 0 0 1 10 0v1h3l-1.4 14H5.4L4 7h3zm2 0h6V6a3 3 0 0 0-6 0v1zm1.7 9.6 5.6-5.6-1.4-1.4-4.2 4.2-2-2-1.4 1.4 3.4 3.4z"/></svg>
    </span>
    <span class="vz-delivery__line"></span>
    <span class="vz-delivery__dot">
      <svg viewBox="0 0 24 24"><path d="M1 5h13v10h1.2l-.2-.2V8h4.2L23 12v6h-2.1a3 3 0 0 1-5.8 0H9.9a3 3 0 0 1-5.8 0H1V5zm16 5v3h4l-2.2-3H17zM7 17a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm11 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/></svg>
    </span>
    <span class="vz-delivery__line"></span>
    <span class="vz-delivery__dot">
      <svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 1 7 7c0 5.2-7 13-7 13S5 14.2 5 9a7 7 0 0 1 7-7zm0 4.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z"/></svg>
    </span>
  </div>
  <div class="vz-delivery__body">
    <div class="vz-delivery__item">
      <p class="vz-delivery__date" data-vz-date="0">{{ 'now' | date: '%-d %b' }}</p>
      <p class="vz-delivery__title">{{ block.settings.step1_label | escape }}</p>
    </div>
    <div class="vz-delivery__item">
      <p class="vz-delivery__date" data-vz-date="ship">&nbsp;</p>
      <p class="vz-delivery__title">{{ block.settings.step2_label | escape }}</p>
    </div>
    <div class="vz-delivery__item">
      <p class="vz-delivery__date" data-vz-date="deliver">&nbsp;</p>
      <p class="vz-delivery__title">{{ block.settings.step3_label | escape }}</p>
    </div>
  </div>
</div>

{% stylesheet %}
  /* Values copied from veyroze's delivery timer (ss_delivery_timer). */
  .vz-delivery { padding: 16px 0; }
  .vz-delivery__top { display: flex; align-items: center; gap: 10px; justify-content: space-between; }
  .vz-delivery__dot { flex: 0 0 var(--vz-dot-size, 38px); height: var(--vz-dot-size, 38px); border-radius: 50%; background: var(--vz-dot, #3a9024); display: flex; align-items: center; justify-content: center; padding: 7px; }
  .vz-delivery__dot svg { display: block; width: 100%; height: 100%; fill: #fff; }
  .vz-delivery__line { flex: 1 1 auto; height: 2px; background: var(--vz-line, #fff); }
  .vz-delivery__body { display: grid; grid-template-columns: repeat(3, 1fr); }
  .vz-delivery__item { text-align: center; }
  .vz-delivery__item:first-child { text-align: left; }
  .vz-delivery__item:last-child { text-align: right; }
  .vz-delivery__date { margin: 0; padding-top: 10px; font-size: var(--vz-date-size, 11px); color: var(--vz-text, #fff); line-height: 1; }
  .vz-delivery__title { margin: 10px 0 0; font-size: var(--vz-title-size, 12px); color: var(--vz-text, #fff); line-height: 1.3; }
{% endstylesheet %}

{% javascript %}
  (() => {
    const addDays = (start, days, business) => {
      const d = new Date(start);
      if (!business) { d.setDate(d.getDate() + days); return d; }
      let left = days;
      while (left > 0) {
        d.setDate(d.getDate() + 1);
        const wd = d.getDay();
        if (wd !== 0 && wd !== 6) left -= 1;
      }
      return d;
    };
    const run = () => {
      document.querySelectorAll('[data-vz-delivery]').forEach((el) => {
        const business = el.dataset.business === 'true';
        let fmt;
        try {
          fmt = new Intl.DateTimeFormat(el.dataset.locale || undefined, { day: 'numeric', month: 'short' });
        } catch (e) {
          fmt = new Intl.DateTimeFormat(undefined, { day: 'numeric', month: 'short' });
        }
        const today = new Date();
        const range = (key) => {
          const [min, max] = (el.dataset[key] || '0,0').split(',').map(Number);
          const a = fmt.format(addDays(today, min, business));
          const b = fmt.format(addDays(today, Math.max(min, max), business));
          return a === b ? a : `${a} - ${b}`;
        };
        const set = (sel, text) => { const n = el.querySelector(`[data-vz-date="${sel}"]`); if (n) n.textContent = text; };
        set('0', fmt.format(today));
        set('ship', range('ship'));
        set('deliver', range('deliver'));
      });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
    else run();
    document.addEventListener('shopify:section:load', run);
  })();
{% endjavascript %}
