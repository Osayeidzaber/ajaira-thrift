  /* Checklist + info accordions */
  .vz-check { list-style: none; margin: 22px 0 6px; padding: 0; display: grid; gap: 10px; }
  .vz-check li { display: flex; align-items: flex-start; gap: 10px; font-size: 1.35rem; line-height: 1.4; color: var(--ink); }
