<div class="product-launch color-{{ section.settings.color_scheme }}">
  {% assign p = section.settings.product %}

  {% capture images_json %}[{% for img in p.images %}{ "src": {{ img | image_url: width: 900 | json }}, "alt": {{ img.alt | default: p.title | json }} }{% unless forloop.last %},{% endunless %}{% endfor %}]{% endcapture %}

  <div class="product-launch__media" data-island="gallery" data-island-id="{{ section.id }}">
    {% if p.featured_image %}{{ p.featured_image | image_url: width: 900 | image_tag: loading: 'lazy' }}{% endif %}
  </div>
  <script type="application/json" data-island-props="{{ section.id }}">{{ images_json }}</script>

  <div class="product-launch__body">
    <p class="product-launch__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="product-launch__title">{{ p.title | default: section.settings.heading }}</h2>
    <p class="product-launch__desc">{{ section.settings.description }}</p>

    {% if section.blocks.size > 0 %}
      <ul class="product-launch__features">
        {% for block in section.blocks %}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {% endfor %}
      </ul>
    {% endif %}

    <a class="product-launch__cta" href="{{ p.url }}">{{ section.settings.cta_label }}</a>
    {% if section.settings.show_price and p != blank %}
      <p class="product-launch__price">{{ p.price | money }}</p>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .product-launch { padding: var(--spacing) 1.5rem; max-width: var(--container); margin: 0 auto; }
  .product-launch__media { border: 1px solid var(--color-line); border-radius: var(--radius); overflow: hidden; background: var(--color-panel); }
  .product-launch__media img { width: 100%; display: block; object-fit: cover; }
  .product-launch__eyebrow { color: var(--color-cta); font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; margin: 1.5rem 0 0.4rem; }
  .product-launch__title { font-size: 1.8rem; margin: 0 0 0.6rem; }
  .product-launch__desc { color: var(--color-mute); font-size: 0.9rem; }
  .product-launch__features { list-style: none; padding: 0; margin: 1rem 0; }
  .product-launch__features li { color: var(--color-mute); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.3rem 0; border-bottom: 1px solid var(--color-line-soft); }
  .product-launch__cta { display: block; text-align: center; background: var(--color-cta); color: var(--color-bg); padding: 0.9rem; border-radius: var(--radius); text-decoration: none; letter-spacing: 0.15em; font-size: 0.8rem; text-transform: uppercase; }
  .product-launch__cta:hover { background: var(--color-cta-hover); }
  .product-launch__price { font-size: 1.1rem; margin-top: 0.8rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Product launch",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New — Vintage" },
    { "type": "text", "id": "heading", "label": "Fallback heading", "default": "Featured piece" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Discover" },
    { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    { "type": "feature", "name": "Feature", "settings": [{ "type": "text", "id": "text", "label": "Text" }] }
  ],
  "presets": [{ "name": "Product launch" }]
}
{% endschema %}