{% doc %}
  Four-up trust icon row under the buy buttons (veyroze product page).

  @param {object} block - main-product `trust_icons` block (icon_1..4 + text_1..4)

  @example
  {% render 'trust-icons', block: block %}
{% enddoc %}
<div class="vz-trust" style="{% if block.settings.icon_color != blank %}--vz-trust-icon: {{ block.settings.icon_color }};{% endif %}{% if block.settings.text_color != blank %}--vz-trust-text: {{ block.settings.text_color }};{% endif %}--vz-trust-size: {{ block.settings.icon_size }}px; --vz-trust-font: {{ block.settings.text_size }}px;" {{ block.shopify_attributes }}>
  {%- for i in (1..4) -%}
    {%- liquid
      assign icon_key = 'icon_' | append: i
      assign text_key = 'text_' | append: i
      assign icon = block.settings[icon_key]
      assign text = block.settings[text_key]
      assign image_key = 'image_' | append: i
      assign custom_icon = block.settings[image_key]
    -%}
    {%- if text != blank -%}
      <div class="vz-trust__item">
        <span class="vz-trust__icon">
          {%- if custom_icon != blank -%}
            {{ custom_icon | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
          {%- else -%}
            {{ 'vz-badge-' | append: icon | append: '.svg' | inline_asset_content }}
          {%- endif -%}
        </span>
        <p class="vz-trust__text">{{ text | escape }}</p>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>

{% stylesheet %}
  /* Values copied from veyroze's product trust badges (ss_trust_badges_pro). */
  .vz-trust { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; padding: 12px 0 16px; }
  .vz-trust__icon { display: block; width: var(--vz-trust-size, 30px); height: var(--vz-trust-size, 30px); margin: 0 auto; color: var(--vz-trust-icon, #fff); }
  .vz-trust__icon svg, .vz-trust__icon img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .vz-trust__text { margin: 6px 0 0; font-size: var(--vz-trust-font, 12px); color: var(--vz-trust-text, #fff); line-height: 1.3; text-align: center; }
  @media (max-width: 1023px) { .vz-trust { padding: 9px 0 12px; } .vz-trust__text { margin-top: 5px; } }
{% endstylesheet %}
