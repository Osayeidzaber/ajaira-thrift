{%- liquid
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.image_mobile | default: section.settings.image
-%}
<div id="Banner-{{ section.id }}" class="veyroze-banner">
  <div class="veyroze-banner__container">
    <div class="veyroze-banner__media veyroze-banner__media--desktop">
      {%- if desktop_image != blank -%}
        {{
          desktop_image
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '100vw',
            widths: '750, 1100, 1500, 1800, 2400',
            class: 'veyroze-banner__img',
            alt: desktop_image.alt
        }}
      {%- else -%}
        {{ 'hero-jackets.jpg' | asset_url | image_tag: class: 'veyroze-banner__img', alt: shop.name, loading: 'eager' }}
      {%- endif -%}
    </div>
    <div class="veyroze-banner__media veyroze-banner__media--mobile">
      {%- if mobile_image != blank -%}
        {{
          mobile_image
          | image_url: width: 1200
          | image_tag:
            loading: 'eager',
            sizes: '100vw',
            widths: '375, 550, 750, 1100, 1200',
            class: 'veyroze-banner__img veyroze-banner__img--mobile',
            alt: mobile_image.alt
        }}
      {%- else -%}
        {{ 'hero-jackets.jpg' | asset_url | image_tag: class: 'veyroze-banner__img', alt: shop.name, loading: 'eager' }}
      {%- endif -%}
    </div>
    <span class="veyroze-banner__overlay" aria-hidden="true"></span>
    <div class="veyroze-banner__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'subheading' -%}
            <p class="veyroze-banner__subheading" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
          {%- when 'heading' -%}
            <h2 class="veyroze-banner__heading {{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</h2>
          {%- when 'text' -%}
            <div class="veyroze-banner__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}
            <div class="veyroze-banner__buttons" {{ block.shopify_attributes }}>
              <a
                {% if block.settings.link != blank %}
                  href="{{ block.settings.link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
                class="button{% if block.settings.style == 'outline' %} button--secondary{% endif %}"
              >
                {{- block.settings.label | escape -}}
              </a>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  #Banner-{{ section.id }} .veyroze-banner__container { height: {{ section.settings.height_mobile }}px; }
  #Banner-{{ section.id }} .veyroze-banner__img--mobile { object-position: {{ section.settings.mobile_position }}; }
  #Banner-{{ section.id }} .veyroze-banner__overlay { background-color: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; }
  #Banner-{{ section.id }} .veyroze-banner__content { color: {{ section.settings.text_color }}; }
  #Banner-{{ section.id }} .veyroze-banner__img:not(.veyroze-banner__img--mobile) { object-position: {{ section.settings.desktop_position_x }}% {{ section.settings.desktop_position_y }}%; }
  @media screen and (min-width: 750px) {
    #Banner-{{ section.id }} .veyroze-banner__container { height: {{ section.settings.height_desktop }}px; }
    #Banner-{{ section.id }} .veyroze-banner__content {
      left: {{ section.settings.content_x }}%;
      top: {{ section.settings.content_y }}%;
      transform: translate(-{{ section.settings.content_x }}%, -{{ section.settings.content_y }}%);
    }
  }
</style>

{% stylesheet %}
  .veyroze-banner { width: 100%; overflow: hidden; }
  .veyroze-banner__container { position: relative; width: 100%; overflow: hidden; }
  .veyroze-banner__media { position: absolute; inset: 0; width: 100%; height: 100%; }
  .veyroze-banner__media--mobile { display: none; }
  .veyroze-banner__img, .veyroze-banner__placeholder { width: 100%; height: 100%; object-fit: cover; display: block; }
  .veyroze-banner__placeholder { background: #1a1a1a; }
  .veyroze-banner__overlay { display: block; position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .veyroze-banner__content { position: absolute; z-index: 2; padding: 2rem; display: flex; flex-direction: column; gap: 1rem; max-width: 60%; text-align: center; align-items: center; }
  .veyroze-banner__subheading { font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.15em; margin: 0; opacity: 0.85; }
  .veyroze-banner__heading { margin: 0; line-height: 1.1; color: inherit; }
  .veyroze-banner__text { font-size: 1rem; margin: 0; opacity: 0.9; max-width: 40ch; }
  .veyroze-banner__buttons { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.25rem; justify-content: center; }
  .veyroze-banner .button { background-color: #fff; color: #000; border-color: #fff; }
  .veyroze-banner .button--secondary { background-color: transparent; color: #fff; border: 1px solid #fff; box-shadow: none; }
  .veyroze-banner .button--secondary::before, .veyroze-banner .button--secondary::after { box-shadow: none; }
  .veyroze-banner .button--secondary:hover { background-color: #fff; color: #000; }
  @media screen and (max-width: 749px) {
    .veyroze-banner__container { display: flex; align-items: center; justify-content: center; }
    .veyroze-banner__media--desktop { display: none; }
    .veyroze-banner__media--mobile { display: block; }
    .veyroze-banner__content { position: relative; width: 90%; max-width: 90%; padding: 1.5rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "veyroze banner",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "range", "id": "desktop_position_x", "label": "Desktop focal point X", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "desktop_position_y", "label": "Desktop focal point Y", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 21 },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Falls back to the desktop image" },
    {
      "type": "select", "id": "mobile_position", "label": "Mobile image position", "default": "center top",
      "options": [
        { "value": "center top", "label": "Top" },
        { "value": "center center", "label": "Center" },
        { "value": "center bottom", "label": "Bottom" }
      ]
    },
    { "type": "range", "id": "height_desktop", "label": "Desktop height", "min": 300, "max": 1000, "step": 25, "unit": "px", "default": 725 },
    { "type": "range", "id": "height_mobile", "label": "Mobile height", "min": 300, "max": 900, "step": 25, "unit": "px", "default": 525 },
    { "type": "range", "id": "content_x", "label": "Content horizontal position", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "content_y", "label": "Content vertical position", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 75 },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 30 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" }
  ],
  "blocks": [
    { "type": "subheading", "name": "Subheading", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "New season" }] },
    {
      "type": "heading", "name": "Heading",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Heading" },
        { "type": "select", "id": "size", "label": "Size", "default": "h1", "options": [{ "value": "h2", "label": "Small" }, { "value": "h1", "label": "Medium" }, { "value": "h0", "label": "Large" }] }
      ]
    },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "text", "label": "Text" }] },
    {
      "type": "button", "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop all" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "style", "label": "Style", "default": "outline", "options": [{ "value": "outline", "label": "Outline" }, { "value": "solid", "label": "Solid" }] }
      ]
    }
  ],
  "presets": [
    { "name": "veyroze banner", "blocks": [{ "type": "button", "settings": { "label": "Shop all", "link": "shopify://collections/all" } }] }
  ]
}
{% endschema %}
