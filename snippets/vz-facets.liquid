{% doc %}
  veyroze-style filter bar ("Filter — SIZE · AVAILABILITY · SORT") with a
  mobile bottom sheet. Built from Shopify storefront filtering, so the options
  come from Search & Discovery (nothing hard-coded).

  @param {object} results - the collection (or search) being filtered
  @param {string} [size_filters] - comma-separated filter param names grouped under one "Size" trigger
  @param {boolean} [enable_sorting] - show the sort dropdown

  @example
  {% render 'vz-facets', results: collection, size_filters: 'filter.p.m.custom.waist,filter.v.option.size', enable_sorting: true %}
{% enddoc %}
{%- liquid
  assign size_list = size_filters | default: '' | remove: ' ' | split: ','
  assign active_count = 0
  for filter in results.filters
    assign active_count = active_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != null or filter.max_value.value != null
        assign active_count = active_count | plus: 1
      endif
    endif
  endfor
  assign sort_by = results.sort_by | default: results.default_sort_by
  assign current_sort_label = ''
  for option in results.sort_options
    if option.value == sort_by
      assign current_sort_label = option.name
    endif
  endfor
-%}

{%- capture size_body -%}
  {%- for filter in results.filters -%}
    {%- if size_list contains filter.param_name and filter.type == 'list' -%}
      <div class="vz-sglabel">{{ filter.label | escape }}</div>
      <div class="vz-sg">
        {%- for value in filter.values -%}
          <label class="vz-chip{% if value.active %} on{% endif %}{% if value.count == 0 and value.active == false %} dis{% endif %}">
            <input
              type="checkbox"
              name="{{ value.param_name }}"
              value="{{ value.value }}"
              {% if value.active %}
                checked
              {% endif %}
            >
            {{ value.label | escape }}
          </label>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- liquid
  assign size_active = 0
  for filter in results.filters
    if size_list contains filter.param_name
      assign size_active = size_active | plus: filter.active_values.size
    endif
  endfor
-%}

{%- capture sort_body -%}
  {%- for option in results.sort_options -%}
    <label class="vz-op">
      <input
        type="radio"
        name="sort_by"
        value="{{ option.value | escape }}"
        {% if option.value == sort_by %}
          checked
        {% endif %}
      >
      <span class="vz-bx vz-bx--round"></span><span class="vz-lb">{{ option.name | escape }}</span>
    </label>
  {%- endfor -%}
{%- endcapture -%}

{%- comment -%} One filter's option list (non-size), reused by bar + sheet. {%- endcomment -%}
{%- capture other_filters_bar -%}
  {%- for filter in results.filters -%}
    {%- if size_list contains filter.param_name -%}{%- continue -%}{%- endif -%}
    <div class="vz-flt" data-vz-flt>
      <button type="button" class="vz-trg{% if filter.active_values.size > 0 %} has{% endif %}" data-vz-trg aria-expanded="false">
        {{ filter.label | escape }}
        <span class="bd">{{ filter.active_values.size }}</span>
        <span class="cv"></span>
      </button>
      <div class="vz-pan">
        {%- render 'vz-facet-options', filter: filter -%}
      </div>
    </div>
  {%- endfor -%}
{%- endcapture -%}

<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500&display=swap">
<div class="vz-fct" data-vz-facets>
  <form class="vz-bar" action="{{ results.url }}" method="get" data-vz-form>
    {%- if results.terms -%}<input type="hidden" name="q" value="{{ results.terms | escape }}">{%- endif -%}
    <span class="vz-lead">{{ 'vz_facets.lead' | t }}</span>

    {%- if size_body != blank -%}
      <div class="vz-flt" data-vz-flt>
        <button type="button" class="vz-trg{% if size_active > 0 %} has{% endif %}" data-vz-trg aria-expanded="false">
          {{ 'vz_facets.size' | t }}
          <span class="bd">{{ size_active }}</span>
          <span class="cv"></span>
        </button>
        <div class="vz-pan vz-pan--size">
          <div class="vz-section-wrap">{{ size_body }}</div>
        </div>
      </div>
    {%- endif -%}

    {{ other_filters_bar }}

    <span class="vz-sp"></span>

    {%- if enable_sorting -%}
      <div class="vz-flt" data-vz-flt>
        <button type="button" class="vz-trg vz-trg--sort" data-vz-trg aria-expanded="false">
          <span class="vz-trg__muted">{{ 'vz_facets.sort' | t }}</span> · <span>{{ current_sort_label | escape }}</span>
          <span class="cv"></span>
        </button>
        <div class="vz-pan r">{{ sort_body }}</div>
      </div>
    {%- endif -%}

    <a class="vz-reset-all{% if active_count > 0 %} show{% endif %}" href="{{ results.url }}{% if results.terms %}?q={{ results.terms | url_encode }}{% endif %}">
      {{- 'vz_facets.clear_all' | t -}}
    </a>
    <span class="vz-cnt">{{ 'vz_facets.count_html' | t: count: results.products_count }}</span>
  </form>

  <button type="button" class="vz-mobtn{% if active_count > 0 %} has{% endif %}" data-vz-open>
    {{ 'vz_facets.filter_and_sort' | t }} <span class="pill">{{ active_count }}</span>
  </button>
  <div class="vz-scrim" data-vz-close></div>
  <div class="vz-sheet" role="dialog" aria-modal="true" aria-label="{{ 'vz_facets.filter_and_sort' | t }}">
    <div class="vz-shead">
      <div class="h">
        {{ 'vz_facets.filter_and_sort' | t -}}
        <small>{{ 'vz_facets.count_plain' | t: count: results.products_count }}</small>
      </div>
      <button type="button" class="vz-close" data-vz-close aria-label="{{ 'accessibility.close' | t }}">×</button>
    </div>
    <form class="vz-sbody" action="{{ results.url }}" method="get" data-vz-form data-vz-manual>
      {%- if results.terms -%}<input type="hidden" name="q" value="{{ results.terms | escape }}">{%- endif -%}
      {%- if size_body != blank -%}
        <div class="vz-acc" data-vz-acc>
          <button type="button" class="vz-ahead" data-vz-acc-trg><span class="at">{{ 'vz_facets.size' | t }}</span><span class="pl"></span></button>
          <div class="vz-acont"><div class="in">{{ size_body }}</div></div>
        </div>
      {%- endif -%}
      {%- for filter in results.filters -%}
        {%- if size_list contains filter.param_name -%}{%- continue -%}{%- endif -%}
        <div class="vz-acc" data-vz-acc>
          <button type="button" class="vz-ahead" data-vz-acc-trg><span class="at">{{ filter.label | escape }}</span><span class="pl"></span></button>
          <div class="vz-acont"><div class="in">{%- render 'vz-facet-options', filter: filter -%}</div></div>
        </div>
      {%- endfor -%}
      {%- if enable_sorting -%}
        <div class="vz-acc" data-vz-acc>
          <button type="button" class="vz-ahead" data-vz-acc-trg><span class="at">{{ 'vz_facets.sort' | t }}</span><span class="pl"></span></button>
          <div class="vz-acont"><div class="in">{{ sort_body }}</div></div>
        </div>
      {%- endif -%}
      <div class="vz-sfoot">
        <a class="clr" href="{{ results.url }}">{{ 'vz_facets.clear' | t }}</a>
        <button type="submit" class="ap">{{ 'vz_facets.apply' | t }}</button>
      </div>
    </form>
  </div>
</div>
