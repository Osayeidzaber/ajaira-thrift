{% javascript %}
  (() => {
    const init = (root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = '1';
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Slideshow
      const slides = [...root.querySelectorAll('.aj-soon__slide')];
      if (slides.length > 1 && !reduce) {
        let i = 0;
        setInterval(() => {
          slides[i].classList.remove('is-active');
          i = (i + 1) % slides.length;
          slides[i].classList.add('is-active');
        }, Number(root.dataset.speed || 6) * 1000);
      }

      // Countdown
      const target = Date.parse(root.dataset.launch || '');
      const nums = [...root.querySelectorAll('[data-soon-unit]')];
      if (!Number.isNaN(target) && nums.length) {
        const tick = () => {
          let s = Math.max(0, Math.floor((target - Date.now()) / 1000));
          if (s === 0) {
            root.querySelector('[data-soon-count]').hidden = true;
            root.querySelector('[data-soon-live]').hidden = false;
            return false;
          }
          const parts = [Math.floor(s / 86400), Math.floor((s % 86400) / 3600), Math.floor((s % 3600) / 60), s % 60];
          parts.forEach((v, idx) => {
            const txt = String(v).padStart(2, '0');
            if (nums[idx].textContent !== txt) {
              nums[idx].textContent = txt;
              if (!reduce) { nums[idx].classList.remove('is-tick'); void nums[idx].offsetWidth; nums[idx].classList.add('is-tick'); }
            }
          });
          return true;
        };
        if (tick()) { const t = setInterval(() => { if (!tick()) clearInterval(t); }, 1000); }
      }

      // Sparkles
      const field = root.querySelector('[data-soon-sparkles]');
      if (field && !reduce) {
        const n = window.innerWidth < 750 ? 14 : 26;
        for (let k = 0; k < n; k += 1) {
          const sp = document.createElement('span');
          sp.className = 'aj-soon__spark';
          sp.textContent = Math.random() > 0.3 ? '✦' : '✧';
          sp.style.left = `${Math.random() * 100}%`;
          sp.style.top = `${Math.random() * 100}%`;
          sp.style.setProperty('--s', `${6 + Math.random() * 14}px`);
          sp.style.setProperty('--t', `${2.2 + Math.random() * 3}s`);
          sp.style.setProperty('--delay', `${Math.random() * 4}s`);
          sp.style.setProperty('--o', `${0.4 + Math.random() * 0.6}`);
          field.appendChild(sp);
        }
      }

      // Mouse parallax (background photos + holographic orbs)
      const layers = [...root.querySelectorAll('[data-soon-parallax]')];
      if (layers.length && !reduce && window.matchMedia('(hover: hover)').matches) {
        let raf = null;
        root.addEventListener('pointermove', (e) => {
          const x = e.clientX / window.innerWidth - 0.5;
          const y = e.clientY / window.innerHeight - 0.5;
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => layers.forEach((l) => {
            const depth = Number(l.dataset.soonParallax || 10);
            l.style.translate = `${-x * depth}px ${-y * depth}px`;
          }));
        });
      }

      // Password panel
      const panel = root.querySelector('[data-soon-pw]');
      const open = () => { panel.hidden = false; document.body.style.overflow = 'hidden'; setTimeout(() => panel.querySelector('input[type=password]')?.focus(), 60); };
      const close = () => { panel.hidden = true; document.body.style.overflow = ''; root.querySelector('[data-soon-open]')?.focus(); };
      root.querySelectorAll('[data-soon-open]').forEach((b) => b.addEventListener('click', open));
      root.querySelectorAll('[data-soon-close]').forEach((b) => b.addEventListener('click', close));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) close(); });
      if (panel.querySelector('[data-soon-failed]') || window.location.hash === '#password') open();
    };
    const all = () => document.querySelectorAll('[data-aj-soon]').forEach(init);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', all); else all();
    document.addEventListener('shopify:section:load', all);
  })();
{% endjavascript %}

