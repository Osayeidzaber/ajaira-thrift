  /* Find your size + size guide dialog */
  .vz-sg-row { display: flex; justify-content: flex-end; margin: -18px 0 22px; }
  .vz-sg-open { background: none; border: 0; padding: 0; font: inherit; font-size: 1.25rem; color: var(--ink); text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; cursor: pointer; }
