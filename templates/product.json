{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "eyebrow": {
          "type": "text",
          "settings": {
            "text": "{{ product.type }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "thrift-specs": {
          "type": "thrift_specs"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "thrift-timeline": {
          "type": "thrift_timeline",
          "settings": {
            "step1_label": "Order placed",
            "step1_dates": "14 Nov",
            "step2_label": "Shipped",
            "step2_dates": "15 Nov – 18 Nov",
            "step3_label": "Delivered",
            "step3_dates": "18 Nov – 21 Nov"
          }
        },
        "description": {
          "type": "description"
        }
      },
      "block_order": [
        "eyebrow",
        "title",
        "price",
        "thrift-specs",
        "buy_buttons",
        "thrift-timeline",
        "description"
      ],
      "settings": {
        "enable_sticky_info": true,
        "gallery_layout": "thumbnail_slider",
        "media_size": "large",
        "constrain_to_viewport": true,
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "trust": {
      "type": "trust-badges",
      "blocks": {
        "b1": { "type": "badge", "settings": { "icon": "return", "text": "14-Days Returns" } },
        "b2": { "type": "badge", "settings": { "icon": "lock", "text": "Secure Payments" } },
        "b3": { "type": "badge", "settings": { "icon": "truck", "text": "Fast DHL Delivery" } },
        "b4": { "type": "badge", "settings": { "icon": "checkmark", "text": "True Vintage" } }
      },
      "block_order": ["b1", "b2", "b3", "b4"],
      "settings": { "color_scheme": "scheme-1" }
    },
    "thrift-details": {
      "type": "thrift-details",
      "settings": {
        "measurements_heading": "Measurements",
        "condition_heading": "Condition",
        "note": "Measured flat — compare with a well-fitting pair of jeans.",
        "care_label": "More about our vintage conditions & care",
        "care_url": "",
        "color_scheme": "scheme-1"
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "trust",
    "thrift-details",
    "related-products"
  ]
}