{%- assign form_id = 'anic-form-' | append: section.id -%}
<section class="anic color-{{ section.settings.color_scheme }}" id="anic-{{ section.id }}" style="{% if section.settings.card_color != blank %}--anic-card: {{ section.settings.card_color }};{% endif %} {% if section.settings.border_color != blank %}--anic-border: {{ section.settings.border_color }};{% endif %} {% if section.settings.button_color != blank %}--anic-btn-bg: {{ section.settings.button_color }};{% endif %} {% if section.settings.button_text_color != blank %}--anic-btn-text: {{ section.settings.button_text_color }};{% endif %} {% if section.settings.whatsapp_icon_color != blank %}--anic-wa: {{ section.settings.whatsapp_icon_color }};{% endif %} {% if section.settings.padding_top != blank %}--anic-pt: {{ section.settings.padding_top }}px;{% endif %} {% if section.settings.padding_bottom != blank %}--anic-pb: {{ section.settings.padding_bottom }}px;{% endif %}">
  <div class="anic__inner">
    <h2 class="anic__heading">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.sub != blank -%}
      <p class="anic__sub">{{ section.settings.sub | escape }}</p>
    {%- endif -%}
    <div class="anic__cards">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'whatsapp' -%}
            <div class="anic__card anic__card--wa" {{ block.shopify_attributes }}>
              <div class="anic__card-top">
                <div class="anic__icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="{{ section.settings.whatsapp_icon_color | default: "#25D366" }}" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                </div>
                <div class="anic__card-body">
                  <p class="anic__card-title">
                    {{- block.settings.title | escape -}}
                    {%- if block.settings.tag != blank -%}<span class="anic__badge">{{ block.settings.tag | escape }}</span>{%- endif -%}
                  </p>
                  <p class="anic__card-desc">{{ block.settings.text | escape }}</p>
                </div>
              </div>
              <a
                {% if block.settings.url != blank %}
                  href="{{ block.settings.url }}"
                {% endif %}
                target="_blank"
                rel="noopener noreferrer"
                class="anic__action anic__btn"
              >
                {{- block.settings.label | escape }} →
              </a>
            </div>
          {%- when 'newsletter' -%}
            <div class="anic__card anic__card--nl" {{ block.shopify_attributes }}>
              <div class="anic__card-top">
                <div class="anic__icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16"/><polyline points="2,7 12,14 22,7"/></svg>
                </div>
                <div class="anic__card-body">
                  <p class="anic__card-title">{{ block.settings.title | escape }}</p>
                  <p class="anic__card-desc">{{ block.settings.text | escape }}</p>
                </div>
              </div>
              {%- form 'customer', id: form_id, class: 'anic__action anic__form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {%- if form.posted_successfully? -%}
                  <p class="anic__ok" role="status">{{ 'newsletter.success' | t }}</p>
                {%- else -%}
                  <input
                    type="email"
                    name="contact[email]"
                    class="anic__email-input"
                    placeholder="{{ block.settings.placeholder | escape }}"
                    aria-label="{{ block.settings.placeholder | escape }}"
                    autocomplete="email"
                    required
                  >
                  <button type="submit" class="anic__email-btn" aria-label="{{ 'newsletter.button_label' | t }}">→</button>
                {%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  /* Copied from veyroze.com "Inner Circle" footer section. */
  .anic { padding: var(--anic-pt, 44px) 48px var(--anic-pb, 40px); text-align: center; border-top: 1px solid rgba(255, 255, 255, 0.08); }
  .anic__inner { max-width: 1100px; margin: 0 auto; }
  .anic__heading { font-family: var(--font-heading-family, 'Cormorant Garamond', Georgia, serif); font-weight: var(--font-heading-weight, 300); font-size: clamp(32px, 4.5vw, 54px); line-height: 1.06; letter-spacing: -0.01em; margin: 0 0 14px; }
  .anic__sub { font-family: var(--font-body-family, inherit); font-size: 13px; opacity: 0.5; line-height: 1.75; margin: 0 0 44px; font-weight: 300; letter-spacing: 0.03em; }
  .anic__cards { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-items: stretch; }
  .anic__card { background: var(--anic-card, rgba(0, 0, 0, 0.3)); border: 1px solid var(--anic-border, rgba(255, 255, 255, 0.09)); border-radius: 6px; padding: 22px; display: flex; flex-direction: column; text-align: left; }
  .anic__card-top { display: flex; align-items: flex-start; gap: 14px; flex: 1; margin-bottom: 16px; }
  .anic__icon { width: 40px; height: 40px; flex-shrink: 0; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 4px; display: flex; align-items: center; justify-content: center; }
  .anic__card-title { font-family: var(--font-body-family, inherit); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 500; margin: 0 0 5px; display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }
  .anic__badge { font-size: 9px; letter-spacing: 0.1em; font-weight: 300; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 3px; padding: 1px 6px; opacity: 0.6; text-transform: uppercase; }
  .anic__card-desc { font-family: var(--font-body-family, inherit); font-size: 11px; opacity: 0.45; line-height: 1.65; margin: 0; font-weight: 300; }
  .anic__action { height: 40px; }
  .anic__btn { display: flex; align-items: center; justify-content: center; gap: 8px; background: var(--anic-btn-bg, rgba(255, 255, 255, 0.92)); border: 1px solid var(--anic-btn-bg, rgba(255, 255, 255, 0.92)); color: var(--anic-btn-text, #0e0e0e); font-family: var(--font-body-family, inherit); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 500; text-decoration: none; border-radius: 4px; transition: background 0.2s, color 0.2s, border-color 0.2s; width: 100%; }
  .anic__btn:hover { background: transparent; color: inherit; border-color: rgba(255, 255, 255, 0.5); }
  .anic__form { display: flex; border: 1px solid rgba(255, 255, 255, 0.4); border-radius: 4px; overflow: hidden; width: 100%; }
  .anic__form:focus-within { border-color: rgba(255, 255, 255, 0.8); }
  .anic__email-input { background: transparent; border: none; outline: none; font-family: var(--font-body-family, inherit); font-size: 12px; letter-spacing: 0.03em; font-weight: 300; padding: 0 14px; flex: 1; min-width: 0; color: inherit; height: 100%; }
  .anic__email-input::placeholder { opacity: 0.55; }
  .anic__email-btn { background: transparent; border: none; border-left: 1px solid rgba(255, 255, 255, 0.25); cursor: pointer; padding: 0 13px; color: inherit; font-size: 15px; flex-shrink: 0; transition: background 0.15s; height: 100%; }
  .anic__email-btn:hover { background: rgba(255, 255, 255, 0.06); }
  .anic__ok { margin: auto; padding: 0 14px; font-size: 11px; }
  @media screen and (max-width: 860px) and (min-width: 501px) { .anic { padding: 36px 32px 32px; } }
  @media screen and (max-width: 500px) {
    .anic { padding: 28px 16px 24px; }
    .anic__heading { font-size: clamp(24px, 7vw, 30px); margin-bottom: 8px; }
    .anic__sub { font-size: 11px; margin-bottom: 22px; }
    .anic__cards { gap: 10px; }
    .anic__card--wa { order: -1; }
    .anic__card--nl { order: 1; }
    .anic__card { padding: 14px 12px; }
    .anic__card-top { margin-bottom: 10px; gap: 10px; }
    .anic__icon { width: 30px; height: 30px; }
    .anic__card-desc { display: none; }
    .anic__card-title { font-size: 9px; letter-spacing: 0.1em; flex-direction: column; align-items: flex-start; gap: 3px; margin-bottom: 0; }
    .anic__badge { font-size: 8px; }
    .anic__action { height: 36px; }
    .anic__btn { font-size: 8px; letter-spacing: 0.1em; }
    .anic__email-input { font-size: 10px; padding: 0 8px; }
    .anic__email-btn { padding: 0 10px; font-size: 13px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Inner Circle",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Inner Circle."
    },
    {
      "type": "text",
      "id": "sub",
      "label": "Subheading",
      "default": "Get early access, exclusive discounts and updates."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "info": "Leave empty to keep the veyroze default."
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card border",
      "info": "Leave empty to keep the veyroze default."
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "info": "Leave empty to keep the veyroze default."
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "info": "Leave empty to keep the veyroze default."
    },
    {
      "type": "color",
      "id": "whatsapp_icon_color",
      "label": "WhatsApp icon color",
      "info": "Leave empty to keep the veyroze default."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "whatsapp",
      "name": "WhatsApp",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Inner Circle"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "WhatsApp"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Join our WhatsApp channel and always be one step ahead."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Join now"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Newsletter"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Sign up and never miss a drop again."
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Email placeholder",
          "default": "Your email"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Inner Circle",
      "blocks": [
        {
          "type": "whatsapp"
        },
        {
          "type": "newsletter"
        }
      ]
    }
  ]
}
{% endschema %}