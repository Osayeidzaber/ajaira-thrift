  .aj-soon__submit { position: relative; overflow: hidden; background: linear-gradient(180deg, #ffffff 0%, #dcdde6 55%, #c3c5d2 100%); color: #120f1e; font-weight: 600; box-shadow: inset 0 1px 0 #fff, 0 6px 18px -6px rgba(160, 150, 255, 0.6); }
  .aj-soon__submit::after { content: ''; position: absolute; top: 0; left: -60%; width: 40%; height: 100%; background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.9), transparent); transform: skewX(-20deg); animation: ajSoonGloss 3.2s ease-in-out infinite; }
  @keyframes ajSoonGloss { 0%, 60% { left: -60%; } 100% { left: 140%; } }
  .aj-soon__pill { border-radius: 999px; color: #fff; }
  .aj-soon__pill:hover { border-color: rgba(255, 255, 255, 0.6); box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.06), 0 10px 26px -10px rgba(150, 140, 255, 0.7); }
