  "class": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "header", "content": "Product details" },
    { "type": "paragraph", "content": "Material, condition, details and measurements come from each product's metafields (namespace below). See docs/thrift-metafields.md." },
    { "type": "text", "id": "metafield_namespace", "label": "Metafield namespace", "default": "thrift" },
    { "type": "text", "id": "material_key", "label": "Material metafield key", "default": "material" },
    { "type": "text", "id": "material_label", "label": "Material label", "default": "Material" },
    { "type": "text", "id": "condition_chip_label", "label": "Condition chip label", "default": "Condition" },
    { "type": "text", "id": "details_chip_label", "label": "Details chip label", "default": "Details" },
    {
      "type": "select", "id": "unique_mode", "label": "Show \"one of one\" line", "default": "always",
      "options": [
        { "value": "always", "label": "Always" },
        { "value": "single_stock", "label": "Only when 1 left in stock" },
        { "value": "never", "label": "Never" }
