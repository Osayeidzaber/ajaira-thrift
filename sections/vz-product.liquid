    { "type": "text", "id": "tax_note", "label": "Note next to price", "default": "incl. VAT" },
    { "type": "checkbox", "id": "show_description", "label": "Show product description", "default": false },
    { "type": "header", "content": "Buttons" },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show express checkout button", "default": true },
    { "type": "checkbox", "id": "show_gift_card_recipient", "label": "Show gift card recipient form", "default": false },
    { "type": "header", "content": "Condition" },
