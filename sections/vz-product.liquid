  @keyframes vzAccIn { from { opacity: 0; transform: translateY(-4px); } }
  .vz-buy-note { display: flex; align-items: center; justify-content: center; gap: 10px; margin: 14px 0 0; font-size: 1.2rem; letter-spacing: 0.02em; color: var(--muted); text-align: center; text-wrap: balance; }
  .vz-buy-note__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green, #3bb273); flex: none; box-shadow: 0 0 0 0 rgba(59, 178, 115, 0.5); animation: vzBuyPulse 2.4s ease-out infinite; }
  @keyframes vzBuyPulse { 0% { box-shadow: 0 0 0 0 rgba(59, 178, 115, 0.45); } 70%, 100% { box-shadow: 0 0 0 8px rgba(59, 178, 115, 0); } }
  @media (prefers-reduced-motion: reduce) { .vz-buy-note__dot { animation: none; } }
  .vz-sh { display: flex; align-items: center; gap: 14px; margin: 36px 0 18px; font-family: var(--font-heading-family, inherit); font-size: clamp(1.8rem, 2.6vw, 2.2rem); font-weight: 400; letter-spacing: 0.005em; }
