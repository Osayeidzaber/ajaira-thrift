  .aj-soon__dot { background: var(--holo); background-size: 300% 300%; animation: ajSoonPulse 1.8s ease-in-out infinite, ajSoonHolo 4s ease infinite; box-shadow: 0 0 12px rgba(200, 180, 255, 0.9); }
  .aj-soon__star { background: var(--holo); background-size: 300% 300%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: ajSoonHolo 5s ease infinite; font-size: 14px; }
  .aj-soon__ticker { border-left: 0; border-right: 0; border-radius: 0; }

  /* glass password panel */
  .aj-soon__pw-scrim { background: rgba(5, 4, 10, 0.35); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  .aj-soon__pw { align-items: center; justify-content: center; padding: 20px; }
  .aj-soon__pw-panel { width: min(440px, 100%); height: auto; border-radius: 28px; padding: 56px 32px 32px; animation: ajSoonPop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); overflow: hidden; }
  .aj-soon__pw-panel::before { content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1px; background: var(--holo); background-size: 300% 300%; animation: ajSoonHolo 8s ease infinite; -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; pointer-events: none; }
  .aj-soon__pw-panel::after { content: '✦'; position: absolute; top: 18px; left: 26px; font-size: 18px; background: var(--holo); background-size: 300% 300%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: ajSoonHolo 5s ease infinite, ajSoonSpin 10s linear infinite; }
  @keyframes ajSoonPop { from { opacity: 0; transform: translateY(24px) scale(0.92); } to { opacity: 1; transform: none; } }
  .aj-soon__pw-title { background: var(--chrome); background-size: 220% 100%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: ajSoonChrome 6s linear infinite; font-size: 40px; }
  .aj-soon__pw-eyebrow { color: #fff; opacity: 0.8; }
