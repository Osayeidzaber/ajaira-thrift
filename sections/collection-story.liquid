{%- liquid
  assign btn_url = section.settings.button_link
  if btn_url == blank and section.settings.collection != blank
    assign btn_url = section.settings.collection.url
  endif
  assign img = section.settings.image | default: section.settings.collection.featured_image
-%}
<section
  class="aj-story aj-story--{{ section.settings.layout }} color-{{ section.settings.color_scheme }} gradient"
  style="--story-h: {{ section.settings.min_height }}px; --story-title: {{ section.settings.heading_size }}px; --story-align: {{ section.settings.text_align }};{% if section.settings.panel_color != blank %} --story-panel: {{ section.settings.panel_color }};{% endif %}{% if section.settings.text_color != blank %} --story-text: {{ section.settings.text_color }};{% endif %}"
>
  <div class="aj-story__media">
    {%- if img != blank -%}
      {{ img | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '600, 900, 1200, 1600' }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'aj-story__placeholder' }}
    {%- endif -%}
  </div>
  <div class="aj-story__panel">
    <div class="aj-story__content">
      {%- if section.settings.eyebrow != blank -%}<p class="aj-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="aj-story__title">{{ section.settings.heading | default: section.settings.collection.title | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="aj-story__text rte">{{ section.settings.text }}</div>
      {%- elsif section.settings.collection.description != blank -%}
        <div class="aj-story__text rte">{{ section.settings.collection.description }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank and btn_url != blank -%}
        <a class="aj-story__btn" href="{{ btn_url }}">
          {{- section.settings.button_label | escape -}}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .aj-story { display: grid; grid-template-columns: 1fr 1fr; min-height: var(--story-h, 640px); }
  .aj-story--image_right .aj-story__media { order: 2; }
  .aj-story__media { position: relative; overflow: hidden; }
  .aj-story__media img, .aj-story__placeholder { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .aj-story__placeholder { background: rgba(var(--color-foreground), 0.06); }
  .aj-story__panel { background: var(--story-panel, #0b0b0b); color: var(--story-text, #fff); display: flex; align-items: center; padding: 64px clamp(24px, 6vw, 96px); }
  .aj-story__content { max-width: 520px; text-align: var(--story-align, left); }
  .aj-story__eyebrow { font-size: 11px; letter-spacing: 0.32em; text-transform: uppercase; opacity: 0.6; margin: 0 0 16px; }
  .aj-story__title { font-size: var(--story-title, 56px); line-height: 0.98; letter-spacing: -0.01em; text-transform: uppercase; font-weight: 500; margin: 0 0 24px; color: inherit; }
  .aj-story__text { font-size: 14px; line-height: 1.7; opacity: 0.82; margin: 0 0 32px; }
  .aj-story__text p { margin: 0 0 12px; }
  .aj-story__btn { display: inline-flex; align-items: center; gap: 12px; padding: 14px 22px; background: var(--story-text, #fff); color: var(--story-panel, #0b0b0b); text-decoration: none; font-size: 12px; letter-spacing: 0.08em; transition: opacity 0.2s, gap 0.2s; }
  .aj-story__btn:hover { gap: 16px; opacity: 0.9; }
  .aj-story__btn svg { width: 16px; height: 16px; }
  @media (max-width: 749px) {
    .aj-story { grid-template-columns: 1fr; min-height: 0; }
    .aj-story__media { aspect-ratio: 4 / 5; order: 0 !important; }
    .aj-story__panel { padding: 40px 20px; }
    .aj-story__title { font-size: calc(var(--story-title, 56px) * 0.64); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection story",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Fills the title, text, image and button link when those are empty." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Small text above heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The collection" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "layout", "label": "Image position", "default": "image_left", "options": [{ "value": "image_left", "label": "Left" }, { "value": "image_right", "label": "Right" }] },
    { "type": "range", "id": "min_height", "label": "Height", "min": 360, "max": 960, "step": 20, "unit": "px", "default": 640 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 96, "step": 2, "unit": "px", "default": 56 },
    { "type": "select", "id": "text_align", "label": "Text alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
    { "type": "header", "content": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color", "id": "panel_color", "label": "Text panel background", "info": "Leave empty for near-black." },
    { "type": "color", "id": "text_color", "label": "Text panel text", "info": "Leave empty for white." }
  ],
  "presets": [{ "name": "Collection story" }]
}
{% endschema %}
