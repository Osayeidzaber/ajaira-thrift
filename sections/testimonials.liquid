{%- liquid
  assign uid = 'aj-rev-' | append: section.id
  assign total = 0
  assign rated = 0
  for block in section.blocks
    if block.settings.rating > 0
      assign total = total | plus: block.settings.rating
      assign rated = rated | plus: 1
    endif
  endfor
  assign average = 0
  if rated > 0
    assign average = total | times: 1.0 | divided_by: rated | round: 1
  endif
  assign rows = section.settings.rows | plus: 0
  assign layout = section.settings.layout
-%}
<section
  id="{{ uid }}"
  class="aj-rev aj-rev--{{ layout }} color-{{ section.settings.color_scheme }} gradient"
  style="--rev-pt: {{ section.settings.padding_top }}px; --rev-pb: {{ section.settings.padding_bottom }}px; --rev-title: {{ section.settings.heading_size }}px; --rev-card: {{ section.settings.card_width }}px; --rev-speed: {{ section.settings.speed }}s;{% if section.settings.accent_color != blank %} --rev-accent: {{ section.settings.accent_color }};{% endif %}{% if section.settings.card_color != blank %} --rev-bg: {{ section.settings.card_color }};{% endif %}{% if section.settings.border_color != blank %} --rev-border: {{ section.settings.border_color }};{% endif %}"
  data-aj-rev
>
  <div class="aj-rev__head page-width">
    <div class="aj-rev__head-text">
      {%- if section.settings.eyebrow != blank -%}<p class="aj-rev__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="aj-rev__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    </div>
    {%- if section.settings.show_summary and rated > 0 -%}
      <div class="aj-rev__summary" aria-label="{{ average }} / 5">
        <span class="aj-rev__avg">{{ average }}</span>
        <span class="aj-rev__summary-meta">
          <span class="aj-rev__stars aj-rev__stars--lg" style="--fill: {{ average | divided_by: 5.0 | times: 100 }}%;" aria-hidden="true"><span>★★★★★</span></span>
          <span class="aj-rev__count">{{ section.settings.summary_label | replace: '[count]', rated | escape }}</span>
        </span>
      </div>
    {%- endif -%}
  </div>

  {%- capture cards -%}
    {%- for block in section.blocks -%}
      {%- assign p = block.settings.product -%}
      <li class="aj-rev__card" {{ block.shopify_attributes }} style="--i: {{ forloop.index0 }};">
        <span class="aj-rev__quote" aria-hidden="true">“</span>
        <div class="aj-rev__top">
          {%- if block.settings.rating > 0 -%}
            <span class="aj-rev__stars" style="--fill: {{ block.settings.rating | times: 20 }}%;" role="img" aria-label="{{ block.settings.rating }} / 5"><span aria-hidden="true">★★★★★</span></span>
          {%- endif -%}
          {%- if block.settings.date != blank -%}<span class="aj-rev__date">{{ block.settings.date | escape }}</span>{%- endif -%}
        </div>
        <div class="aj-rev__text">{{ block.settings.text }}</div>
        {%- if block.settings.photo != blank -%}
          <div class="aj-rev__photo">{{ block.settings.photo | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '260px', widths: '300, 450, 600', alt: '' }}</div>
        {%- endif -%}
        <div class="aj-rev__who">
          <span class="aj-rev__avatar" aria-hidden="true">{{ block.settings.author | slice: 0 | upcase }}</span>
          <span class="aj-rev__who-text">
            <span class="aj-rev__author">{{ block.settings.author | escape }}</span>
            {%- if block.settings.location != blank or block.settings.verified -%}
              <span class="aj-rev__meta">
                {%- if block.settings.verified -%}
                  <span class="aj-rev__verified"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1l1.8 1.3 2.2-.1.7 2.1 1.8 1.3-.7 2.1.7 2.1-1.8 1.3-.7 2.1-2.2-.1L8 15l-1.8-1.3-2.2.1-.7-2.1L1.5 10.4l.7-2.1-.7-2.1 1.8-1.3.7-2.1 2.2.1z" fill="currentColor"/><path d="M5.3 8.2l1.8 1.8 3.6-3.8" fill="none" stroke="#0b0b0b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ section.settings.verified_label | escape }}</span>
                {%- endif -%}
                {%- if block.settings.location != blank -%}<span>{{ block.settings.location | escape }}</span>{%- endif -%}
              </span>
            {%- endif -%}
          </span>
        </div>
        {%- if p != blank -%}
          <a class="aj-rev__product" href="{{ p.url }}" tabindex="-1">
            {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
            <span class="aj-rev__product-text">{{ p.title | escape }}<small>{{ p.price | money }}</small></span>
            <svg class="aj-rev__product-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  {%- endcapture -%}

  <div class="aj-rev__stage" data-rev-stage>
    {%- if layout == 'marquee' -%}
      {%- for r in (1..rows) -%}
        <div class="aj-rev__lane{% if r == 2 %} aj-rev__lane--reverse{% endif %}" data-rev-lane>
          <ul class="aj-rev__row" role="list" data-rev-row>{{ cards }}</ul>
          <ul class="aj-rev__row" role="list" aria-hidden="true" data-rev-clone>{{ cards }}</ul>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="aj-rev__scroller">
        <ul class="aj-rev__grid aj-rev__grid--{{ rows }}" role="list">{{ cards }}</ul>
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
    <div class="aj-rev__footer">
      <a href="{{ section.settings.button_link }}" class="aj-rev__btn">
        {{- section.settings.button_label | escape -}}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .aj-rev {
    --rev-accent-c: var(--rev-accent, #c8a45c);
    --rev-bg-c: var(--rev-bg, rgba(var(--color-foreground), 0.035));
    --rev-border-c: var(--rev-border, rgba(var(--color-foreground), 0.1));
    position: relative; padding: var(--rev-pt, 64px) 0 var(--rev-pb, 64px); overflow: hidden;
  }
  .aj-rev::before {
    content: ''; position: absolute; inset: -20% -10% auto; height: 70%; pointer-events: none;
    background: radial-gradient(50% 60% at 50% 0%, color-mix(in srgb, var(--rev-accent-c) 14%, transparent), transparent 70%);
    opacity: 0; transition: opacity 1.2s ease;
  }
  .aj-rev.is-in::before { opacity: 1; }

  /* Header */
  .aj-rev__head { position: relative; display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-bottom: 36px; }
  .aj-rev__eyebrow { margin: 0 0 12px; font-size: 11px; letter-spacing: 0.32em; text-transform: uppercase; color: var(--rev-accent-c); }
  .aj-rev__title { margin: 0; font-size: var(--rev-title, 44px); font-weight: 400; line-height: 1; letter-spacing: -0.01em; }
  .aj-rev__head-text, .aj-rev__summary { opacity: 0; transform: translateY(14px); transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1); }
  .aj-rev__summary { transition-delay: 0.15s; display: flex; align-items: center; gap: 14px; }
  .aj-rev.is-in .aj-rev__head-text, .aj-rev.is-in .aj-rev__summary { opacity: 1; transform: none; }
  .aj-rev__avg { font-family: var(--font-heading-family); font-size: 48px; line-height: 1; }
  .aj-rev__summary-meta { display: flex; flex-direction: column; gap: 6px; }
  .aj-rev__count { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.6; }

  /* Stars: fill animates in */
  .aj-rev__stars { position: relative; display: inline-block; font-size: 12px; letter-spacing: 3px; line-height: 1; color: rgba(var(--color-foreground), 0.18); }
  .aj-rev__stars > span { position: relative; display: inline-block; }
  .aj-rev__stars::after {
    content: '★★★★★'; position: absolute; left: 0; top: 0; overflow: hidden; white-space: nowrap; letter-spacing: 3px;
    color: var(--rev-accent-c); width: 0; transition: width 1.1s cubic-bezier(0.22, 0.61, 0.36, 1) calc(0.25s + var(--i, 0) * 0.06s);
    text-shadow: 0 0 12px color-mix(in srgb, var(--rev-accent-c) 45%, transparent);
  }
  .aj-rev.is-in .aj-rev__stars::after { width: var(--fill, 100%); }
  .aj-rev__stars--lg { font-size: 16px; }

  /* Cards */
  .aj-rev__card {
    position: relative; width: var(--rev-card, 300px); flex: 0 0 auto; padding: 24px 22px 20px; border-radius: 14px;
    background: var(--rev-bg-c); border: 1px solid var(--rev-border-c);
    display: flex; flex-direction: column; gap: 14px; isolation: isolate; overflow: hidden;
    transition: transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1), border-color 0.4s, box-shadow 0.5s;
    transform-style: preserve-3d;
  }
  .aj-rev__card::before {
    content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit; opacity: 0; transition: opacity 0.4s;
    background: radial-gradient(240px circle at var(--mx, 50%) var(--my, 0%), color-mix(in srgb, var(--rev-accent-c) 16%, transparent), transparent 60%);
  }
  .aj-rev__card:hover { border-color: color-mix(in srgb, var(--rev-accent-c) 55%, transparent); box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.7); }
  .aj-rev__card:hover::before { opacity: 1; }
  .aj-rev__quote { position: absolute; top: -18px; right: 14px; font-family: var(--font-heading-family); font-size: 120px; line-height: 1; color: var(--rev-accent-c); opacity: 0.14; pointer-events: none; transition: opacity 0.4s, transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1); }
  .aj-rev__card:hover .aj-rev__quote { opacity: 0.32; transform: translateY(4px) rotate(-4deg); }
  .aj-rev__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .aj-rev__date { font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.45; }
  .aj-rev__text { font-size: 14px; line-height: 1.65; opacity: 0.88; flex: 1; }
  .aj-rev__text p { margin: 0 0 8px; }
  .aj-rev__text p:last-child { margin: 0; }
  .aj-rev__photo { border-radius: 8px; overflow: hidden; aspect-ratio: 4 / 3; }
  .aj-rev__photo img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1); }
  .aj-rev__card:hover .aj-rev__photo img { transform: scale(1.05); }
  .aj-rev__who { display: flex; align-items: center; gap: 12px; }
  .aj-rev__avatar {
    width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
    font-family: var(--font-heading-family); font-size: 15px; color: #0b0b0b;
    background: linear-gradient(135deg, var(--rev-accent-c), color-mix(in srgb, var(--rev-accent-c) 55%, #fff));
  }
  .aj-rev__who-text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .aj-rev__author { font-size: 13px; font-weight: 600; letter-spacing: 0.02em; }
  .aj-rev__meta { display: flex; flex-wrap: wrap; gap: 4px 10px; font-size: 10.5px; letter-spacing: 0.06em; opacity: 0.6; }
  .aj-rev__verified { display: inline-flex; align-items: center; gap: 4px; color: var(--rev-accent-c); opacity: 1; }
  .aj-rev__meta .aj-rev__verified { opacity: 1; }
  .aj-rev__verified svg { width: 12px; height: 12px; }
  .aj-rev__product {
    display: flex; align-items: center; gap: 10px; margin: 2px -8px -6px; padding: 8px; border-radius: 10px;
    color: inherit; text-decoration: none; font-size: 11.5px; background: rgba(var(--color-foreground), 0.04); transition: background 0.3s;
  }
  .aj-rev__product:hover { background: rgba(var(--color-foreground), 0.09); }
  .aj-rev__product img { width: 38px; height: 38px; object-fit: cover; border-radius: 6px; }
  .aj-rev__product-text { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .aj-rev__product small { display: block; opacity: 0.55; margin-top: 2px; }
  .aj-rev__product-arrow { width: 14px; height: 14px; opacity: 0.4; transition: transform 0.3s, opacity 0.3s; }
  .aj-rev__product:hover .aj-rev__product-arrow { opacity: 1; transform: translateX(3px); }

  /* Marquee lanes */
  .aj-rev__stage { position: relative; display: flex; flex-direction: column; gap: 16px; }
  .aj-rev--marquee .aj-rev__stage { -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .aj-rev__lane { display: flex; width: max-content; gap: 16px; padding: 6px 0; animation: ajRevScroll var(--rev-speed, 60s) linear infinite; animation-play-state: paused; }
  .aj-rev.is-in .aj-rev__lane { animation-play-state: running; }
  .aj-rev__lane--reverse { animation-direction: reverse; }
  .aj-rev__lane:hover, .aj-rev__lane:focus-within { animation-play-state: paused !important; }
  .aj-rev__row { list-style: none; margin: 0; padding: 0; display: flex; gap: 16px; align-items: stretch; }
  @keyframes ajRevScroll { from { transform: translateX(0); } to { transform: translateX(calc(-50% - 8px)); } }

  /* Card entrance */
  .aj-rev__card { opacity: 0; translate: 0 22px; transition: opacity 0.7s ease calc(var(--i, 0) * 0.07s), translate 0.8s cubic-bezier(0.22, 0.61, 0.36, 1) calc(var(--i, 0) * 0.07s), transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1), border-color 0.4s, box-shadow 0.5s; }
  .aj-rev.is-in .aj-rev__card { opacity: 1; translate: 0 0; }

  /* Scroll layout */
  .aj-rev__scroller { overflow-x: auto; scrollbar-width: none; padding: 6px max(1.5rem, calc((100vw - var(--page-width, 120rem)) / 2 + 5rem)) 12px; cursor: grab; }
  .aj-rev__scroller::-webkit-scrollbar { display: none; }
  .aj-rev__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-auto-flow: column; grid-auto-columns: var(--rev-card, 300px); gap: 16px; }
  .aj-rev__grid .aj-rev__card { width: auto; }
  .aj-rev__grid--2 { grid-template-rows: auto auto; }

  /* Footer button */
  .aj-rev__footer { text-align: center; margin-top: 36px; }
  .aj-rev__btn { display: inline-flex; align-items: center; gap: 10px; padding: 12px 22px; border: 1px solid rgba(var(--color-foreground), 0.35); border-radius: 999px; color: inherit; text-decoration: none; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; transition: border-color 0.3s, gap 0.3s, background 0.3s; }
  .aj-rev__btn svg { width: 14px; height: 14px; }
  .aj-rev__btn:hover { border-color: var(--rev-accent-c); gap: 14px; background: color-mix(in srgb, var(--rev-accent-c) 10%, transparent); }

  @media (max-width: 749px) {
    .aj-rev__title { font-size: calc(var(--rev-title, 44px) * 0.7); }
    .aj-rev__avg { font-size: 36px; }
    .aj-rev__card { width: min(78vw, var(--rev-card, 300px)); }
    .aj-rev__scroller { padding: 6px 1.5rem 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .aj-rev__lane { animation: none; }
    .aj-rev--marquee .aj-rev__stage { overflow-x: auto; }
    .aj-rev__card, .aj-rev__head-text, .aj-rev__summary { opacity: 1; translate: none; transform: none; transition: none; }
    .aj-rev__stars::after { transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const init = (root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = '1';

      // Reveal when scrolled into view (stars fill, cards rise, lanes start moving).
      if ('IntersectionObserver' in window && !reduce) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { root.classList.add('is-in'); io.disconnect(); }
          });
        }, { threshold: 0.15 });
        io.observe(root);
      } else {
        root.classList.add('is-in');
      }

      // Spotlight + gentle tilt that follows the cursor.
      if (!reduce && window.matchMedia('(hover: hover)').matches) {
        root.addEventListener('pointermove', (e) => {
          const card = e.target.closest('.aj-rev__card');
          if (!card) return;
          const r = card.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width;
          const y = (e.clientY - r.top) / r.height;
          card.style.setProperty('--mx', `${x * 100}%`);
          card.style.setProperty('--my', `${y * 100}%`);
          card.style.transform = `perspective(800px) rotateX(${(0.5 - y) * 5}deg) rotateY(${(x - 0.5) * 6}deg) translateY(-4px)`;
        });
        root.addEventListener('pointerout', (e) => {
          const card = e.target.closest('.aj-rev__card');
          if (card && !card.contains(e.relatedTarget)) card.style.transform = '';
        });
      }

      // Drag-to-scroll for the scroll layout.
      const scroller = root.querySelector('.aj-rev__scroller');
      if (scroller) {
        let down = false, x0 = 0, left0 = 0;
        scroller.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') return; down = true; x0 = e.clientX; left0 = scroller.scrollLeft; });
        window.addEventListener('pointermove', (e) => { if (down) scroller.scrollLeft = left0 - (e.clientX - x0); });
        window.addEventListener('pointerup', () => { down = false; });
      }

      // Marquee: repeat cards until one copy is wider than the screen, so the loop never shows a gap.
      root.querySelectorAll('[data-rev-lane]').forEach((lane) => {
        const row = lane.querySelector('[data-rev-row]');
        const clone = lane.querySelector('[data-rev-clone]');
        if (!row || !clone || !row.children.length) return;
        const original = [...row.children].map((c) => c.cloneNode(true));
        let guard = 0;
        while (row.scrollWidth < window.innerWidth * 1.2 && guard < 6) {
          original.forEach((c) => {
            const copy = c.cloneNode(true);
            copy.setAttribute('aria-hidden', 'true');
            copy.removeAttribute('data-shopify-editor-block');
            row.appendChild(copy);
          });
          guard += 1;
        }
        clone.innerHTML = row.innerHTML;
        clone.querySelectorAll('a').forEach((a) => a.setAttribute('tabindex', '-1'));
      });
    };
    const all = () => document.querySelectorAll('[data-aj-rev]').forEach(init);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', all); else all();
    document.addEventListener('shopify:section:load', all);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Customer reviews",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Reviews you type in yourself. The rating summary is calculated from the stars you give each review." },
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Real customers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Worn & loved" },
    { "type": "checkbox", "id": "show_summary", "label": "Show average rating", "default": true },
    { "type": "text", "id": "summary_label", "label": "Rating summary text", "default": "From [count] reviews", "info": "[count] is replaced by the number of reviews." },
    { "type": "text", "id": "verified_label", "label": "Verified badge text", "default": "Verified buyer" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Layout & motion" },
    {
      "type": "select", "id": "layout", "label": "Layout", "default": "marquee",
      "options": [
        { "value": "marquee", "label": "Moving rows (pause on hover)" },
        { "value": "scroll", "label": "Drag / swipe rows" }
      ]
    },
    { "type": "select", "id": "rows", "label": "Rows", "default": "2", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }] },
    { "type": "range", "id": "speed", "label": "Movement duration (higher = slower)", "min": 20, "max": 160, "step": 5, "unit": "s", "default": 70 },
    { "type": "range", "id": "card_width", "label": "Card width", "min": 220, "max": 420, "step": 10, "unit": "px", "default": 300 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 44 },
    { "type": "header", "content": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color", "id": "accent_color", "label": "Accent (stars, quote mark, badge)", "info": "Leave empty for gold." },
    { "type": "color", "id": "card_color", "label": "Card background", "info": "Leave empty for a soft tint." },
    { "type": "color", "id": "border_color", "label": "Card border" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "author", "label": "Customer name", "default": "Customer name" },
        { "type": "richtext", "id": "text", "label": "Review", "default": "<p>Write what the customer said.</p>" },
        { "type": "range", "id": "rating", "label": "Stars (0 hides them)", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "checkbox", "id": "verified", "label": "Show \"Verified buyer\"", "default": true },
        { "type": "text", "id": "location", "label": "City or country" },
        { "type": "text", "id": "date", "label": "Date", "info": "e.g. March 2026" },
        { "type": "image_picker", "id": "photo", "label": "Customer photo", "info": "Optional." },
        { "type": "product", "id": "product", "label": "Product they bought" }
      ]
    }
  ],
  "presets": [{ "name": "Customer reviews", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }, { "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
