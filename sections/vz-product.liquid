    { "type": "text", "id": "condition_heading", "label": "Heading", "default": "Condition" },
    { "type": "text", "id": "scale_low", "label": "Scale left label", "default": "Worn" },
    { "type": "text", "id": "scale_mid", "label": "Scale middle label", "default": "Very good" },
    { "type": "text", "id": "scale_high", "label": "Scale right label", "default": "Like new" },
    { "type": "page", "id": "condition_page", "label": "\"More about conditions\" page" },
