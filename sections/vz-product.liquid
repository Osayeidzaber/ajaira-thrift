    { "type": "range", "id": "gap", "label": "Gap between gallery and info", "min": 16, "max": 120, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 100 }
  ],
  "blocks": [
    {
      "type": "size_chart",
      "name": "Size chart",
      "settings": [
        { "type": "paragraph", "content": "Add one size chart per kind of product. The first chart whose rule matches the product is shown." },
        {
