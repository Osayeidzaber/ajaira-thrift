<div class="trust-badges color-{{ section.settings.color_scheme }}">
  {% for block in section.blocks %}
    <div class="trust-badges__item" {{ block.shopify_attributes }}>
      {%- if block.settings.icon != 'none' -%}
        <span class="trust-badges__icon" aria-hidden="true">
          {{- block.settings.icon | prepend: 'icon-' | append: '.svg' | inline_asset_content -}}
        </span>
      {%- endif -%}
      <span>{{ block.settings.text }}</span>
    </div>
  {% endfor %}
</div>

{% stylesheet %}
  .trust-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--color-line-soft);
    border-bottom: 1px solid var(--color-line-soft);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .trust-badges__item { display: flex; align-items: center; gap: 0.5rem; }
  .trust-badges__icon { display: inline-flex; color: var(--color-ink); }
  .trust-badges__icon svg { width: 1.1rem; height: 1.1rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust badges",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "return", "label": "Return" },
            { "value": "lock", "label": "Lock" },
            { "value": "truck", "label": "Truck" },
            { "value": "checkmark", "label": "Checkmark" },
            { "value": "box", "label": "Box" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" },
            { "value": "plane", "label": "Plane" },
            { "value": "stopwatch", "label": "Stopwatch" },
            { "value": "price-tag", "label": "Price tag" }
          ],
          "default": "checkmark"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Worldwide shipping" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "plane", "text": "Worldwide shipping" } },
        { "type": "badge", "settings": { "icon": "return", "text": "14 days return policy" } },
        { "type": "badge", "settings": { "icon": "lock", "text": "Secure checkout" } }
      ]
    }
  ]
}
{% endschema %}