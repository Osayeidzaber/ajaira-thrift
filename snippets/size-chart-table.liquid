{%- comment -%}
  Size chart table for the Find your size dialog.
  - custom_rows (product metafield thrift.size_chart_rows): first line is the
    header, then one row per line, cells separated by "|", any number of columns.
  - default_rows (section setting): "size | inches | cm" under a two-level header.
  The row matching the product's own size gets the .is-mine highlight.
  Params: product, custom_rows, default_rows, col_size, col_measure, unit_a, unit_b
{%- endcomment -%}
{%- liquid
  assign my_size = ''
  for option in product.options_with_values
    assign oname = option.name | downcase | strip
    if oname == 'size' or oname == 'sizes'
      assign my_size = option.selected_value | downcase | strip
    endif
  endfor
  if my_size == blank and product.metafields.thrift.size.value != blank
    assign my_size = product.metafields.thrift.size.value | downcase | strip
  endif

  assign source = default_rows
  if custom_rows != blank
    assign source = custom_rows
  endif
  assign raw_lines = source | newline_to_br | split: '<br />'
  assign lines = ''
  for line in raw_lines
    assign t = line | strip
    if t != blank
      assign lines = lines | append: t | append: '~~'
    endif
  endfor
  assign lines = lines | split: '~~'
-%}
<table class="vz-sg__table">
  {%- if custom_rows != blank -%}
    {%- assign head = lines.first | split: '|' -%}
    <thead>
      <tr>{%- for c in head -%}<th scope="col">{{ c | strip | escape }}</th>{%- endfor -%}</tr>
    </thead>
    <tbody>
      {%- for line in lines offset: 1 -%}
        {%- assign cells = line | split: '|' -%}
        {%- assign first = cells.first | strip | downcase -%}
        <tr{% if my_size != blank and first == my_size %} class="is-mine"{% endif %}>
          {%- for c in cells -%}
            {%- if forloop.first -%}<th scope="row">{{ c | strip | escape }}</th>{%- else -%}<td>{{ c | strip | escape }}</td>{%- endif -%}
          {%- endfor -%}
        </tr>
      {%- endfor -%}
    </tbody>
  {%- else -%}
    <thead>
      <tr><th rowspan="2" scope="col">{{ col_size | escape }}</th><th colspan="2" scope="colgroup">{{ col_measure | escape }}</th></tr>
      <tr><th scope="col">{{ unit_a | escape }}</th><th scope="col">{{ unit_b | escape }}</th></tr>
    </thead>
    <tbody>
      {%- for line in lines -%}
        {%- assign cells = line | split: '|' -%}
        {%- assign first = cells.first | strip | downcase -%}
        <tr{% if my_size != blank and first == my_size %} class="is-mine"{% endif %}>
          <th scope="row">{{ cells[0] | strip | escape }}</th>
          <td>{{ cells[1] | strip | escape }}</td>
          <td>{{ cells[2] | strip | escape }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
  {%- endif -%}
</table>
