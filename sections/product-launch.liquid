{%- liquid
  assign uid = 'vzl-' | append: section.id
  assign flip_first = false
  if section.settings.media_position == 'right'
    assign flip_first = true
  endif
  assign launch_blocks = section.blocks | where: 'type', 'launch'
  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign main_product = section.settings.product
  assign pick = section.settings.newest_position | plus: 0
  if pick > 0
    assign newest = collections.all.products | sort: 'created_at' | reverse | where: 'available', true
    assign idx = pick | minus: 1
    if newest[idx] != blank
      assign main_product = newest[idx]
    endif
  endif
-%}
{%- capture features_html -%}
  {%- for block in feature_blocks -%}<li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>{%- endfor -%}
{%- endcapture -%}
<section id="{{ uid }}" data-autoplay="{{ section.settings.autoplay }}" class="vzl" style="--vzl-title-size: {{ section.settings.title_size }}px; --vzl-align: {{ section.settings.text_align }}; {% if section.settings.accent_color != blank %}--gold: {{ section.settings.accent_color }};{% endif %} {% if section.settings.text_color != blank %}--ink: {{ section.settings.text_color }};{% endif %} {% if section.settings.muted_color != blank %}--muted: {{ section.settings.muted_color }};{% endif %} {% if section.settings.line_color != blank %}--line: {{ section.settings.line_color }};{% endif %} {% if section.settings.button_text_color != blank %}--vzl-cta-text: {{ section.settings.button_text_color }};{% endif %} {% if section.settings.button_hover_color != blank %}--vzl-cta-hover: {{ section.settings.button_hover_color }};{% endif %} {% if section.settings.media_bg != blank %}--vzl-media-bg: {{ section.settings.media_bg }};{% endif %}">
  {%- if main_product != blank or launch_blocks.size == 0 -%}
    {%- render 'vzl-row',
      product: main_product,
      row_id: section.id,
      flip: flip_first,
      badge: section.settings.badge,
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      description: section.settings.description,
      description_words: section.settings.description_words,
      features_html: features_html,
      cta_label: section.settings.cta_label,
      show_price: section.settings.show_price,
      max_images: section.settings.max_images
    -%}
  {%- endif -%}
  {%- for block in launch_blocks -%}
    {%- liquid
      assign offset = forloop.index
      if main_product == blank
        assign offset = forloop.index0
      endif
      assign is_flip = flip_first
      assign odd = offset | modulo: 2
      if odd == 1
        if flip_first
          assign is_flip = false
        else
          assign is_flip = true
        endif
      endif
      if block.settings.media_position == 'right'
        assign is_flip = true
      elsif block.settings.media_position == 'left'
        assign is_flip = false
      endif
      assign row_id = section.id | append: '-' | append: block.id
      assign row_badge = block.settings.badge | default: section.settings.badge
    -%}
    {%- capture block_attrs -%}{{ block.shopify_attributes }}{%- endcapture -%}
    {%- render 'vzl-row',
      product: block.settings.product,
      row_id: row_id,
      flip: is_flip,
      badge: row_badge,
      eyebrow: block.settings.eyebrow,
      heading: block.settings.heading,
      description: block.settings.description,
      description_words: section.settings.description_words,
      features: block.settings.features,
      cta_label: block.settings.cta_label,
      show_price: section.settings.show_price,
      max_images: section.settings.max_images,
      attrs: block_attrs
    -%}
  {%- endfor -%}
</section>

<style>
  #{{ uid }} { padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px; }
  #{{ uid }} .vzl__inner + .vzl__inner { margin-top: {{ section.settings.row_gap }}px; }
</style>

{% stylesheet %}
  /* Copied from veyroze.com "veyroze product launch". */
  .vzl {
    --vzl-gold: var(--gold, #c8a45c); --vzl-ink: var(--ink, #f4f1ea); --vzl-muted: var(--muted, rgba(255, 255, 255, 0.55));
    --vzl-line: var(--line, rgba(255, 255, 255, 0.09)); --vzl-line2: var(--line2, rgba(255, 255, 255, 0.2));
    color: var(--vzl-ink); font-family: var(--font-body-family, 'Jost', sans-serif);
  }
  .vzl *, .vzl *::before, .vzl *::after { box-sizing: border-box; }
  .vzl__inner { max-width: 1200px; margin: 0 auto; position: relative; display: grid; grid-template-columns: 1fr; gap: 32px; align-items: center; }
  @media (min-width: 900px) { .vzl__inner { grid-template-columns: 1fr 1fr; gap: 64px; } .vzl__inner--flip .vzl__media { order: 2; } }
  .vzl__placeholder { position: absolute; inset: 0; width: 100%; height: 100%; background: rgba(255, 255, 255, 0.04); fill: rgba(255, 255, 255, 0.25); }
  .vzl__title a { color: inherit; text-decoration: none; }
  .vzl__compare { opacity: 0.5; font-size: 0.7em; margin-left: 8px; }
  .vzl__media { touch-action: pan-y; }
  .vzl__media { position: relative; aspect-ratio: 4 / 5; border: 1px solid var(--vzl-line); border-radius: 12px; overflow: hidden; background: var(--vzl-media-bg, #0a0a0a); }
  .vzl__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vzl__media-empty { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: rgba(255, 255, 255, 0.28); }
  .vzl__badge { position: absolute; top: 16px; left: 16px; z-index: 3; font-size: 9.5px; letter-spacing: 0.28em; text-transform: uppercase; color: #0a0a0a; background: var(--vzl-gold); padding: 6px 12px; border-radius: 4px; }
  .vzl__radio { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .vzl__frames { position: absolute; inset: 0; }
  .vzl__frames img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: none; }
  .vzl__navs { position: absolute; inset: 0; pointer-events: none; }
  .vzl__navs .vzl__arrow { pointer-events: auto; }
  .vzl__arrow { position: absolute; top: 50%; z-index: 2; width: 48px; height: 48px; display: none; align-items: center; justify-content: center; transform: translateY(-50%); background: rgba(70, 70, 70, 0.55); border: 0; border-radius: 50%; color: #fff; cursor: pointer; transition: background-color 0.15s ease; }
  .vzl__arrow:hover { background: rgba(70, 70, 70, 0.8); }
  .vzl__arrow--prev { left: 14px; }
  .vzl__arrow--next { right: 14px; }
  .vzl__arrow span { width: 10px; height: 10px; border-top: 1.5px solid currentColor; border-right: 1.5px solid currentColor; }
  .vzl__arrow--prev span { transform: rotate(-135deg); margin-left: 4px; }
  .vzl__arrow--next span { transform: rotate(45deg); margin-right: 4px; }
  @media (max-width: 749px) {
    .vzl__arrow { width: 40px; height: 40px; }
    .vzl__arrow--prev { left: 10px; }
    .vzl__arrow--next { right: 10px; }
  }
  .vzl__dots { position: absolute; bottom: 14px; left: 0; right: 0; z-index: 2; display: flex; justify-content: center; gap: 8px; }
  .vzl__dot { display: block; width: 7px; height: 7px; padding: 0; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.5); background: none; cursor: pointer; transition: background-color 0.15s ease, border-color 0.15s ease; }
  .vzl__body { text-align: var(--vzl-align, left); }
  .vzl__eyebrow { font-size: 11px; letter-spacing: 0.38em; text-transform: uppercase; color: var(--vzl-gold); margin: 0 0 16px; }
  .vzl__title { font-family: var(--font-heading-family, 'Cormorant Garamond', serif); font-weight: 500; font-size: clamp(calc(var(--vzl-title-size, 44px) * 0.68), 3.6vw, var(--vzl-title-size, 44px)); line-height: 1.1; letter-spacing: 0.01em; margin: 0 0 14px; }
  .vzl__text { font-size: 15px; line-height: 1.75; color: var(--vzl-muted); margin: 0 0 26px; max-width: 46ch; }
  .vzl__text p { margin: 0 0 12px; }
  .vzl__text p:last-child { margin-bottom: 0; }
  .vzl__features { list-style: none; padding: 0; margin: 0 0 30px; }
  .vzl__features li { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--vzl-muted); padding: 9px 0; border-top: 1px solid var(--vzl-line); }
  .vzl__features li:last-child { border-bottom: 1px solid var(--vzl-line); }
  .vzl__features li::before { content: '◆'; color: var(--vzl-gold); font-size: 8px; margin-right: 10px; vertical-align: 1px; }
  .vzl__cta { display: inline-flex; align-items: center; justify-content: center; height: 56px; padding: 0 40px; background: var(--vzl-gold); color: var(--vzl-cta-text, #0a0a0a); border: 1px solid var(--vzl-gold); border-radius: 8px; text-decoration: none; font-size: 12px; letter-spacing: 0.26em; text-transform: uppercase; transition: background-color 0.15s ease, border-color 0.15s ease; }
  .vzl__cta:hover { background: var(--vzl-cta-hover, #d4b26e); border-color: var(--vzl-cta-hover, #d4b26e); }
  .vzl__cta:focus-visible, .vzl__arrow:focus-visible { outline: 2px solid var(--vzl-gold); outline-offset: 3px; }
  .vzl__price { display: block; margin-top: 18px; font-family: var(--font-heading-family, 'Cormorant Garamond', serif); font-size: 25px; letter-spacing: 0.02em; color: var(--vzl-ink); }
  @media (max-width: 899px) { .vzl__cta { width: 100%; padding: 0 20px; } }
  @media (prefers-reduced-motion: reduce) { .vzl * { transition: none !important; } }
{% endstylesheet %}

{% javascript %}
  (() => {
    const init = (section) => {
      if (section.dataset.vzlReady) return;
      section.dataset.vzlReady = '1';
      const autoplay = Number(section.dataset.autoplay || 0);
      section.querySelectorAll('[data-vzl-gallery]').forEach((gallery) => {
        const radios = [...gallery.querySelectorAll('.vzl__radio')];
        if (radios.length < 2) return;
        const go = (dir) => {
          const i = radios.findIndex((r) => r.checked);
          radios[(i + dir + radios.length) % radios.length].checked = true;
        };
        let x0 = null;
        gallery.addEventListener('pointerdown', (e) => { x0 = e.clientX; }, { passive: true });
        gallery.addEventListener('pointerup', (e) => {
          if (x0 === null) return;
          const dx = e.clientX - x0;
          x0 = null;
          if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);
        });
        if (autoplay > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          let timer = setInterval(() => go(1), autoplay * 1000);
          gallery.addEventListener('mouseenter', () => clearInterval(timer));
          gallery.addEventListener('mouseleave', () => {
            clearInterval(timer);
            timer = setInterval(() => go(1), autoplay * 1000);
          });
        }
      });
    };
    const all = () => document.querySelectorAll('.vzl').forEach(init);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', all); else all();
    document.addEventListener('shopify:section:load', all);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Product launch",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "newest_position",
      "label": "Show automatically",
      "info": "Newest = the latest in-stock product you added. Choose Off to pick the product yourself below.",
      "default": "0",
      "options": [
        { "value": "0", "label": "Off (use the product below)" },
        { "value": "1", "label": "Newest product" },
        { "value": "2", "label": "2nd newest product" },
        { "value": "3", "label": "3rd newest product" }
      ]
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "range",
      "id": "max_images",
      "label": "Max gallery images",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "New"
    },
    {
