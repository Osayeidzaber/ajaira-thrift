  .vz-sg__panel { position: static; height: 100%; overflow-y: auto; overscroll-behavior: contain; padding: 0 24px 28px; scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.2) transparent; }
  .vz-sg__title { position: sticky; top: 0; z-index: 2; margin: 0 -24px 18px; padding: 22px 64px 18px 24px; background: var(--sg-bg); border-bottom: 1px solid var(--sg-line); font-family: var(--font-heading-family, inherit); font-size: 2rem; font-weight: 400; letter-spacing: 0.01em; color: var(--sg-ink); }
