  .aj-soon__orb--b { width: 46vmax; height: 46vmax; right: -10%; top: -12%; background: radial-gradient(circle, #6fc8ff 0%, transparent 65%); animation: ajSoonDriftB 22s ease-in-out infinite alternate; }
  .aj-soon__orb--c { width: 38vmax; height: 38vmax; left: 34%; bottom: -18%; background: radial-gradient(circle, #a58bff 0%, transparent 65%); animation: ajSoonDriftC 26s ease-in-out infinite alternate; }
  @keyframes ajSoonDriftA { to { transform: translate(18vw, 10vh) scale(1.15); } }
  @keyframes ajSoonDriftB { to { transform: translate(-14vw, 16vh) scale(0.9); } }
  @keyframes ajSoonDriftC { to { transform: translate(-12vw, -14vh) scale(1.1); } }

  .aj-soon__sparkles { position: absolute; inset: 0; pointer-events: none; }
  .aj-soon__spark { position: absolute; color: #fff; font-size: var(--s, 12px); line-height: 1; opacity: 0; text-shadow: 0 0 8px rgba(255, 255, 255, 0.8); animation: ajSoonTwinkle var(--t, 3s) ease-in-out var(--delay, 0s) infinite; }
  @keyframes ajSoonTwinkle { 0%, 100% { opacity: 0; transform: scale(0.4) rotate(0deg); } 50% { opacity: var(--o, 0.9); transform: scale(1) rotate(45deg); } }

  /* glass helpers */
  .aj-soon__enter, .aj-soon__glass, .aj-soon__pill, .aj-soon__ticker, .aj-soon__pw-panel {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.04));
    -webkit-backdrop-filter: blur(22px) saturate(160%); backdrop-filter: blur(22px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.24);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), inset 0 -1px 0 rgba(255, 255, 255, 0.05), 0 20px 50px -20px rgba(0, 0, 0, 0.7);
  }

  /* chrome wordmark with sweeping shine */
  .aj-soon__word--chrome .aj-soon__char {
    background: var(--chrome); background-size: 220% 100%; -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: ajSoonRise 1.1s cubic-bezier(0.19, 1, 0.22, 1) forwards, ajSoonChrome 5s linear infinite;
    animation-delay: calc(0.45s + var(--d) * 0.06s), calc(var(--d) * -0.12s);
    filter: drop-shadow(0 2px 0 rgba(255, 255, 255, 0.15)) drop-shadow(0 18px 30px rgba(130, 120, 255, 0.25));
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes ajSoonChrome { from { background-position: 0% 50%; } to { background-position: 220% 50%; } }
  .aj-soon__word--chrome:hover .aj-soon__char { transform: translateY(-4%); }
  .aj-soon__word--chrome .aj-soon__char:hover { transform: translateY(-10%) rotate(-3deg) !important; }

  /* rotating badge */
  .aj-soon__badge { position: absolute; top: clamp(90px, 14vh, 140px); right: clamp(16px, 6vw, 90px); width: clamp(96px, 11vw, 150px); aspect-ratio: 1; opacity: 0; animation: ajSoonFade 1s ease 1.2s forwards; }
  .aj-soon__badge svg { width: 100%; height: 100%; animation: ajSoonSpin 18s linear infinite; overflow: visible; }
  .aj-soon__badge text { fill: rgba(255, 255, 255, 0.85); font-size: 15px; letter-spacing: 4px; text-transform: uppercase; font-family: var(--font-body-family); }
  .aj-soon__badge-star { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: clamp(22px, 2.6vw, 34px); background: var(--holo); background-size: 300% 300%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: ajSoonHolo 6s ease infinite; }
  @keyframes ajSoonSpin { to { transform: rotate(360deg); } }
  .aj-soon__hero { position: relative; }

  /* glass card */
  .aj-soon__glass { position: relative; margin-top: 36px; padding: clamp(22px, 3vw, 34px) clamp(18px, 3vw, 40px); border-radius: 28px; width: min(640px, 100%); display: flex; flex-direction: column; align-items: center; opacity: 0; animation: ajSoonFade 1s ease 1.3s forwards; }
  .aj-soon__glass::before { content: ''; position: absolute; inset: -1px; border-radius: inherit; padding: 1px; background: var(--holo); background-size: 300% 300%; animation: ajSoonHolo 8s ease infinite; -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; opacity: 0.7; pointer-events: none; }
  @keyframes ajSoonHolo { 0%, 100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
  .aj-soon__glass .aj-soon__count, .aj-soon__glass .aj-soon__signup, .aj-soon__glass .aj-soon__social { opacity: 1; animation: none; }
