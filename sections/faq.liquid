<div class="faq color-{{ section.settings.color_scheme }}">
  <h2 class="faq__title">{{ section.settings.heading }}</h2>
  <div class="faq__grid">
    {% for block in section.blocks %}
      <details class="faq__item" {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question }}</summary>
        <div class="faq__answer">{{ block.settings.answer }}</div>
      </details>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .faq { padding: var(--spacing) 1.5rem; max-width: var(--container); margin: 0 auto; }
  .faq__title { text-align: center; font-size: 1.8rem; margin: 0 0 2rem; }
  .faq__grid { display: grid; gap: 0.8rem; }
  .faq__item { border: 1px solid var(--color-line); border-radius: var(--radius); background: var(--color-panel); }
  .faq__item summary { cursor: pointer; padding: 1rem; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; list-style: none; display: flex; justify-content: space-between; }
  .faq__item summary::after { content: "+"; }
  .faq__item[open] summary::after { content: "–"; }
  .faq__answer { padding: 0 1rem 1rem; color: var(--color-mute); font-size: 0.9rem; }
  @media (min-width: 750px) { .faq__grid { grid-template-columns: 1fr 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQ" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "item", "settings": { "question": "When will my order arrive?", "answer": "<p>Orders ship within 1-2 business days.</p>" } },
        { "type": "item", "settings": { "question": "How can I return my order?", "answer": "<p>You have 14 days to return your order.</p>" } }
      ]
    }
  ]
}
{% endschema %}