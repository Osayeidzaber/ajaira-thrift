<section
  class="aj-reviews color-{{ section.settings.color_scheme }} gradient"
  style="--rev-pt: {{ section.settings.padding_top }}px; --rev-pb: {{ section.settings.padding_bottom }}px; --rev-title: {{ section.settings.heading_size }}px; --rev-card: {{ section.settings.card_width }}px;{% if section.settings.card_color != blank %} --rev-bg: {{ section.settings.card_color }};{% endif %}{% if section.settings.border_color != blank %} --rev-border: {{ section.settings.border_color }};{% endif %}"
>
  <div class="aj-reviews__head page-width">
    {%- if section.settings.heading != blank -%}<h2 class="aj-reviews__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  </div>
  <div class="aj-reviews__scroller" data-lenis-prevent-wheel>
    <ul class="aj-reviews__grid aj-reviews__grid--{{ section.settings.rows }}" role="list">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <li class="aj-reviews__card" {{ block.shopify_attributes }}>
          {%- if block.settings.rating > 0 -%}
            <p class="aj-reviews__stars" aria-label="{{ block.settings.rating }} / 5">
              {%- for i in (1..5) -%}<span{% if i > block.settings.rating %} class="is-off"{% endif %}>★</span>{%- endfor -%}
            </p>
          {%- endif -%}
          <p class="aj-reviews__author">{{ block.settings.author | escape }}</p>
          <div class="aj-reviews__text">{{ block.settings.text }}</div>
          {%- if p != blank -%}
            <a class="aj-reviews__product" href="{{ p.url }}">
              {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
              <span>{{ p.title | escape }}<small>{{ p.price | money }}</small></span>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .aj-reviews { padding: var(--rev-pt, 64px) 0 var(--rev-pb, 64px); }
  .aj-reviews__title { font-size: var(--rev-title, 44px); margin: 0 0 28px; font-weight: 400; }
  .aj-reviews__scroller { overflow-x: auto; scrollbar-width: thin; padding: 0 max(1.5rem, calc((100vw - var(--page-width, 120rem)) / 2 + 5rem)) 12px; }
  .aj-reviews__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-auto-flow: column; grid-auto-columns: var(--rev-card, 260px); gap: 14px; }
  .aj-reviews__grid--2 { grid-template-rows: auto auto; }
  .aj-reviews__card { background: var(--rev-bg, rgba(var(--color-foreground), 0.04)); border: 1px solid var(--rev-border, rgba(var(--color-foreground), 0.12)); border-radius: 6px; padding: 18px; display: flex; flex-direction: column; gap: 10px; }
  .aj-reviews__stars { margin: 0; font-size: 12px; letter-spacing: 2px; }
  .aj-reviews__stars .is-off { opacity: 0.25; }
  .aj-reviews__author { margin: 0; font-size: 13px; font-weight: 600; }
  .aj-reviews__text { font-size: 13px; line-height: 1.6; opacity: 0.8; flex: 1; }
  .aj-reviews__text p { margin: 0; }
  .aj-reviews__product { display: flex; align-items: center; gap: 10px; padding-top: 10px; border-top: 1px solid var(--rev-border, rgba(var(--color-foreground), 0.12)); color: inherit; text-decoration: none; font-size: 11px; }
  .aj-reviews__product img { width: 36px; height: 36px; object-fit: cover; border-radius: 3px; }
  .aj-reviews__product small { display: block; opacity: 0.6; margin-top: 2px; }
  @media (max-width: 749px) { .aj-reviews__title { font-size: calc(var(--rev-title, 44px) * 0.7); } .aj-reviews__scroller { padding: 0 1.5rem 12px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Customer reviews",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Built-in reviews you type in yourself. For automatic reviews, use a reviews app block instead." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Worn & loved" },
    { "type": "select", "id": "rows", "label": "Rows", "default": "2", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }] },
    { "type": "range", "id": "card_width", "label": "Card width", "min": 200, "max": 400, "step": 10, "unit": "px", "default": 260 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 72, "step": 2, "unit": "px", "default": 44 },
    { "type": "header", "content": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color", "id": "card_color", "label": "Card background", "info": "Leave empty for a soft tint of the text color." },
    { "type": "color", "id": "border_color", "label": "Card border" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "author", "label": "Customer name", "default": "Customer name" },
        { "type": "richtext", "id": "text", "label": "Review", "default": "<p>Write what the customer said.</p>" },
        { "type": "range", "id": "rating", "label": "Stars (0 hides them)", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "product", "id": "product", "label": "Product they bought" }
      ]
    }
  ],
  "presets": [{ "name": "Customer reviews", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
