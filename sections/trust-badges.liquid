<div class="trust-badges color-{{ section.settings.color_scheme }}" style="--tb-size: {{ section.settings.label_size }}px; --tb-icon: {{ section.settings.icon_size }}px; {% if section.settings.text_color != blank %}--tb-text: {{ section.settings.text_color }};{% endif %} {% if section.settings.border_color != blank %}--tb-border: {{ section.settings.border_color }};{% endif %} {% if section.settings.divider_color != blank %}--tb-divider: {{ section.settings.divider_color }};{% endif %} {% if section.settings.padding_top != blank %}--tb-pt: {{ section.settings.padding_top }}px;{% endif %} {% if section.settings.padding_bottom != blank %}--tb-pb: {{ section.settings.padding_bottom }}px;{% endif %}">
  <div class="trust-badges__inner">
    {%- for block in section.blocks -%}
      <div class="trust-badges__item" {{ block.shopify_attributes }}>
        <div class="trust-badges__icon" aria-hidden="true">
          {%- if block.settings.custom_icon != blank -%}
            {{ block.settings.custom_icon | image_url: width: 80 | image_tag: loading: 'lazy', alt: '', class: 'trust-badges__img' }}
          {%- else -%}
          {%- case block.settings.icon -%}
            {%- when 'globe' -%}
              <svg viewBox="0 0 30 30" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="13" cy="14" r="9.5"/>
                <path d="M3.5 14h19M13 4.5a13 13 0 0 1 3.5 9.5 13 13 0 0 1-3.5 9.5A13 13 0 0 1 9.5 14 13 13 0 0 1 13 4.5z"/>
                <rect x="20" y="20" width="9" height="9" rx="1" fill="transparent" stroke="currentColor" stroke-width="1.3"/>
                <line x1="20" y1="23.5" x2="29" y2="23.5" stroke-width="1.3"/>
                <line x1="24.5" y1="20" x2="24.5" y2="23.5" stroke-width="1.3"/>
              </svg>
            {%- when 'return' -%}
              <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter">
                <line x1="22" y1="8" x2="6" y2="8"/>
                <polyline points="10,4 6,8 10,12"/>
                <rect x="6" y="14" width="16" height="10" rx="0"/>
              </svg>
            {%- when 'lock' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                <circle cx="12" cy="16.5" r="1" fill="currentColor" stroke="none"/>
              </svg>
          {%- endcase -%}
          {%- endif -%}
        </div>
        <span class="trust-badges__label">{{ block.settings.text }}</span>
      </div>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .trust-badges {
    background: transparent;
    padding: var(--tb-pt, 16px) 16px var(--tb-pb, 16px);
    width: 100%;
    border-top: 1px solid var(--tb-border, rgba(128, 128, 128, 0.15));
    border-bottom: 1px solid var(--tb-border, rgba(128, 128, 128, 0.15));
    box-sizing: border-box;
  }
  .trust-badges__inner {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    max-width: 1100px;
    margin: 0 auto;
    gap: 0;
  }
  .trust-badges__item {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 0 20px;
    flex: 1;
    justify-content: center;
    position: relative;
  }
  .trust-badges__item:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 24px;
    width: 1px;
    background: var(--tb-divider, rgba(128, 128, 128, 0.25));
  }
  .trust-badges__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--tb-text, var(--color-ink));
  }
  .trust-badges__icon svg, .trust-badges__img { width: var(--tb-icon, 19px); height: var(--tb-icon, 19px); object-fit: contain; }
  .trust-badges__label {
    font-family: var(--font-heading-family);
    font-size: var(--tb-size, 11.5px);
    font-weight: 600;
    color: var(--tb-text, var(--color-ink));
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  @media screen and (max-width: 749px) {
    .trust-badges { padding: 12px 8px; }
    .trust-badges__item { flex-direction: column; gap: 5px; padding: 0 4px; }
    .trust-badges__item:not(:last-child)::after { height: 36px; }
    .trust-badges__icon svg { width: 15px; height: 15px; }
    .trust-badges__label {
      font-size: 8.5px;
      letter-spacing: 0.07em;
      white-space: normal;
      text-align: center;
      max-width: 80px;
      line-height: 1.3;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust badges",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & icon color",
      "info": "Leave empty to keep the veyroze default."
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Top/bottom border",
      "info": "Leave empty to keep the veyroze default."
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "info": "Leave empty to keep the veyroze default."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Typography & layout"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Text size",
      "min": 9,
      "max": 18,
      "step": 0.5,
      "unit": "px",
      "default": 11.5
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 19
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "globe",
              "label": "Worldwide shipping (globe)"
            },
            {
              "value": "return",
              "label": "Return policy (box)"
            },
            {
              "value": "lock",
              "label": "Secure checkout (lock)"
            }
          ],
          "default": "globe"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Worldwide Shipping"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon",
          "info": "Optional: replaces the built-in icon."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "globe",
            "text": "Worldwide Shipping"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "return",
            "text": "14 Days Return Policy"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "lock",
            "text": "Secure Checkout"
          }
        }
      ]
    }
  ]
}
{% endschema %}